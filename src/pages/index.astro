---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Button from "@/components/Button.astro";
import Statement from "@/components/content/Statement.astro";
import SectionHead from "@/components/content/SectionHead.astro";
import ConcernIndex from "@/components/content/ConcernIndex.astro";
import StepList from "@/components/content/StepList.astro";
import ResultsScatter from "@/components/content/ResultsScatter.astro";
import JournalCards from "@/components/content/JournalCards.astro";
import ClosingInvitation from "@/components/content/ClosingInvitation.astro";
import { BOOK_URL, clinic, clinicLinks } from "@/data/site.ts";

/* The home page (wireframe wf-home, Home.pdf at 1728): the client's copy word for word, the typo « Alreay know what
   youre » corrected (PROJECT.md). Photos are frames that say what goes there until the clinic supplies them. */
const href = (label: string) =>
  clinicLinks.find((link) => link.label === label)?.href ?? "#";

const steps = [
  {
    title: "Consultation",
    text: "Understanding your concerns, your priorities and your face.",
  },
  {
    title: "Assessment",
    text: "A structured read of what is happening beneath the surface.",
  },
  {
    title: "Planning",
    text: "A plan built around your goals, not a standard protocol.",
  },
  {
    title: "Ongoing care",
    text: "Continuity, so your care evolves as you do.",
  },
];
---

<Layout
  title="Doctor-led cosmetic medicine in Byron Bay"
  description="We look beyond isolated treatments to consider structure, surface and facial cohesion as a whole. Dr Tranter Aesthetics, 1/54 Jonson Street, Byron Bay."
>
  {/* Opening: the dark statement, the photo under it, the clinic's address and phone at its foot */}
  <Section theme="burgundy" paddingTop="small" paddingBottom="small">
    <div class="home-opening_layout site-grid">
      <div class="home-opening_statement">
        <Statement
          lines={[
            "We look beyond isolated treatments",
            '<span class="weight-regular">to consider structure, surface and facial cohesion as a whole.</span>',
          ]}
        />
      </div>
      <div class="home-opening_photo media-frame">
        <span class="media-placeholder">Opening photo to supply</span>
      </div>
      <address class="home-opening_address">
        <span class="text-style-label">{clinic.locality}</span>
        <span>{clinic.street}, {clinic.locality} {clinic.region} {clinic.postcode}</span>
      </address>
      <p class="home-opening_phone">
        <a href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a>
      </p>
    </div>
  </Section>

  {/* Concerns: the signature, the fifteen concerns as one large list */}
  <Section theme="sand" paddingTop="small" paddingBottom="medium">
    <div class="home-concerns_layout site-grid">
      <SectionHead>Where would you like to start?</SectionHead>
      <div class="column-body">
        <ConcernIndex />
      </div>
      <div class="home-concerns_actions column-body">
        <Button element="link" href="/concerns">View all concerns</Button>
        <p class="home-concerns_browse">
          Already know what you're looking for?
          <Button element="link" variant="link" href={href("All treatments")}
            >Browse treatments</Button
          >
        </p>
      </div>
    </div>
  </Section>

  {/* Approach: the four steps beside a photo, the two actions under them */}
  <Section theme="mist" paddingTop="small" paddingBottom="medium">
    <div class="home-approach_layout site-grid">
      <SectionHead>The Dr Tranter Aesthetics approach</SectionHead>
      <div class="home-approach_steps">
        <StepList name="approach" items={steps} />
      </div>
      <div class="home-approach_photo media-frame">
        <span class="media-placeholder">Photo of the clinic to supply</span>
      </div>
      <div class="home-approach_actions">
        <Button element="link" href={href("Our approach")}
          >Learn more</Button
        >
        <Button element="link" href={BOOK_URL}>Book a consultation</Button>
      </div>
    </div>
  </Section>

  {/* Results: four cases scattered on a computer, a row swiped on a phone */}
  <Section theme="stone" paddingTop="small" paddingBottom="medium">
    <div class="home-results_layout site-grid">
      <div class="home-results_head">
        <SectionHead>Proof, not promises. Real results.</SectionHead>
      </div>
      <div class="home-results_cases">
        <ResultsScatter />
      </div>
      <div class="home-results_action">
        <Button element="link" href={href("Results")}
          >View all results</Button
        >
      </div>
    </div>
  </Section>

  {/* Founder: the heading, the name and the text beside the portrait */}
  <Section theme="burgundy" paddingTop="small" paddingBottom="medium">
    <div class="home-founder_layout site-grid">
      <h2 class="home-founder_heading text-style-h2">Meet the founder.</h2>
      <p class="home-founder_name">
        <span class="text-style-h4">Dr Sarah Tranter</span>
        <span class="home-founder_role">Founder & Cosmetic Physician, 15+ years in practice</span>
      </p>
      <p class="home-founder_text">
        Dr Sarah Tranter founded the clinic on a simple premise: that treatment
        should follow judgement, not the other way around. Her approach considers
        the face as one system of structure and surface, not a list of isolated
        concerns. Every protocol at the clinic reflects standards she has set
        personally, whether or not she is the one delivering care.
      </p>
      <div class="home-founder_photo media-frame">
        <span class="media-placeholder">Portrait of Dr Sarah Tranter to supply</span>
      </div>
    </div>
  </Section>

  {/* Journal: the three latest articles */}
  <Section theme="sand" paddingTop="small" paddingBottom="medium">
    <div class="home-journal_layout site-grid">
      <h2 class="home-journal_heading text-style-h2">
        Our journal: notes on skin, structure and care
      </h2>
      <div class="home-journal_action">
        <Button element="link" href={href("Journal")}
          >View all articles</Button
        >
      </div>
      <div class="home-journal_cards">
        <JournalCards limit={3} />
      </div>
    </div>
  </Section>

  <ClosingInvitation heading="Every new patient begins with a consultation." />
</Layout>

<style is:global>
  @layer components {
    /* Opening */
    .home-opening_layout {
      row-gap: var(--space-6);
    }

    .home-opening_statement {
      grid-column: 1 / -1;
      padding-top: var(--space-6);
      @media (width >= 64rem) {
        grid-column: var(--body-start) / span 7;
      }
    }

    .home-opening_photo {
      grid-column: 1 / -1;
      --media-ratio: 4 / 5;
      @media (width >= 48rem) {
        grid-column: var(--body-start) / span 4;
        --media-ratio: 1 / 1;
      }
    }

    .home-opening_address,
    .home-opening_phone {
      margin: 0;
      font-style: normal;
      color: var(--text-2);
    }

    .home-opening_address {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      grid-column: 1 / span 3;
      @media (width >= 64rem) {
        grid-column: 1 / span 2;
      }
    }

    .home-opening_phone {
      grid-column: 1 / -1;
      align-self: end;
      @media (width >= 48rem) {
        grid-column: 4 / span 2;
      }
      @media (width >= 64rem) {
        grid-column: 3 / span 2;
      }
      & a {
        text-decoration: none;
      }
    }

    /* Concerns */
    .home-concerns_layout {
      row-gap: var(--space-7);
    }

    .home-concerns_actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-5) var(--space-7);
    }

    .home-concerns_browse {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-2);
      margin: 0;
      color: var(--text-2);
    }

    /* Approach */
    .home-approach_layout {
      row-gap: var(--space-7);
    }

    .home-approach_steps {
      grid-column: 1 / -1;
      @media (width >= 64rem) {
        grid-column: var(--body-start) / span 5;
      }
    }

    .home-approach_photo {
      grid-column: 1 / -1;
      --media-ratio: 4 / 3;
      @media (width >= 48rem) {
        --media-ratio: 3 / 4;
      }
      @media (width >= 48rem) {
        grid-column: 5 / -1;
      }
      @media (width >= 64rem) {
        grid-column: 10 / -1;
      }
    }

    .home-approach_actions {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: calc(var(--site-gutter) / 2);
      @media (width >= 64rem) {
        grid-column: var(--body-start) / span 6;
      }
    }

    /* Results */
    .home-results_layout {
      row-gap: var(--space-7);
    }

    .home-results_head {
      display: contents;
      & .section-head_wrap {
        @media (width >= 64rem) {
          grid-column: 1 / span 6;
        }
      }
    }

    .home-results_cases {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
    }

    .home-results_action {
      grid-column: 1 / -1;
      display: flex;
      @media (width >= 64rem) {
        grid-column: 10 / -1;
        justify-content: flex-end;
      }
    }

    /* Founder */
    .home-founder_layout {
      row-gap: var(--space-6);
      align-items: start;
    }

    .home-founder_heading {
      grid-column: 1 / -1;
      margin: 0;
      @media (width >= 64rem) {
        grid-column: 1 / span 6;
      }
    }

    .home-founder_photo {
      grid-column: 1 / -1;
      --media-ratio: 4 / 5;
      @media (width >= 64rem) {
        --media-ratio: 1 / 1;
      }
      @media (width >= 48rem) {
        grid-column: 5 / -1;
        grid-row: 2 / span 2;
      }
      @media (width >= 64rem) {
        grid-column: 8 / -1;
      }
    }

    .home-founder_name {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      grid-column: 1 / -1;
      margin: 0;
      @media (width >= 48rem) {
        grid-column: 1 / span 4;
        grid-row: 2;
      }
      @media (width >= 64rem) {
        grid-column: 5 / span 3;
        padding-top: var(--space-7);
      }
    }

    .home-founder_role {
      color: var(--text-2);
    }

    .home-founder_text {
      grid-column: 1 / -1;
      margin: 0;
      max-width: 44ch;
      @media (width >= 48rem) {
        grid-column: 1 / span 4;
        grid-row: 3;
      }
      @media (width >= 64rem) {
        grid-column: 4 / span 4;
      }
    }

    /* Journal */
    .home-journal_layout {
      row-gap: var(--space-7);
      align-items: end;
    }

    .home-journal_heading {
      grid-column: 1 / -1;
      margin: 0;
      @media (width >= 64rem) {
        grid-column: 1 / span 8;
      }
    }

    .home-journal_action {
      grid-column: 1 / -1;
      display: flex;
      @media (width >= 64rem) {
        grid-column: 10 / -1;
        justify-content: flex-end;
      }
    }

    .home-journal_cards {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
    }
  }
</style>

---
import Layout from "@/layouts/BaseLayout.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import ConcernsHome from "@/components/section/ConcernsHome.astro";
import StepsSection from "@/components/section/StepsSection.astro";
import CardGroup from "@/components/section/CardGroup.astro";
import PeopleHome from "@/components/section/PeopleHome.astro";
import { getItems } from "@/utils/content";
import JournalHome from "@/components/section/JournalHome.astro";
import CtaBand from "@/components/section/CtaBand.astro";

/* the featured treatments (the collection's « Featured », as on the Treatments page) */
const featured = (await getItems("treatments"))
  .filter((t) => t.data.featured)
  .map((t) => ({ id: t.id, name: t.data.name, summary: t.data.summary, image: t.data.image && { src: t.data.image, alt: t.data.imageAlt } }));
---

<Layout title="Cosmetic medicine, Byron Bay" overlap>
  {/* Hero */}
  <HeroHome />
  {/* Concerns */}
  <ConcernsHome />
  {/* Approach */}
  <StepsSection
    title="The Dr Tranter Aesthetics <em>approach</em>"
    theme="stone"
    tall
    list="approach-steps"
    steps={[
      { title: "Consultation", text: "Understanding your concerns, your priorities and your face.", ids: ["1:96", "1:97", "1:98"] },
      { title: "Assessment", text: "A structured read of what is happening beneath the surface.", ids: ["1:99", "1:100", "1:101"] },
      { title: "Planning", text: "A plan built around your goals, not a standard protocol.", ids: ["1:102", "1:103", "1:104"] },
      { title: "Ongoing care", text: "Continuity, so your care evolves&nbsp;as&nbsp;you&nbsp;do.", ids: ["1:105", "1:106", "1:107"] },
    ]}
    image={{ src: "/img/approach.jpg", alt: "Two women talking in the clinic, one holding a folder" }}
    actions={{ pill: { label: "Learn more", href: "/approach", figma: "1:109" }, link: { label: "Book a consultation →", href: "#consultation", figma: "1:111" } }}
    figma={{ band: "approach", top: "2156.19", title: "1:95", image: "1:94" }}
  />
  {/* Featured treatments (Figma 4001:96, Nov 25) */}
  <CardGroup label="Featured treatments" title="Featured <em>treatments</em>" theme="mist" collection="treatments" noun="Treatment" list="featured-treatments" items={featured} action={{ label: "All treatments →", href: "/treatments" }} />
  {/* The founder, then the team, in one scroll */}
  <PeopleHome />
  {/* Journal */}
  <JournalHome />
  {/* Consultation */}
  <CtaBand />
</Layout>

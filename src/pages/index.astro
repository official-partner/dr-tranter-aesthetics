---
import Layout from "@/layouts/BaseLayout.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import ConcernsHome from "@/components/section/ConcernsHome.astro";
import StepsSection from "@/components/section/StepsSection.astro";
import ResultsHome from "@/components/section/ResultsHome.astro";
import FounderHome from "@/components/section/FounderHome.astro";
import JournalHome from "@/components/section/JournalHome.astro";
import CtaBand from "@/components/section/CtaBand.astro";
---

<Layout title="Cosmetic medicine, Byron Bay" overlap>
  {/* Hero */}
  <HeroHome />
  {/* Concerns */}
  <ConcernsHome />
  {/* Approach */}
  <StepsSection
    title="The Dr Tranter Aesthetics <em>approach</em>"
    theme="mist"
    tall
    list="approach-steps"
    steps={[
      { title: "Consultation", text: "Understanding your concerns, your priorities and your face.", ids: ["1:96", "1:97", "1:98"] },
      { title: "Assessment", text: "A structured read of what is happening beneath the surface.", ids: ["1:99", "1:100", "1:101"] },
      { title: "Planning", text: "A plan built around your goals, not a standard protocol.", ids: ["1:102", "1:103", "1:104"] },
      { title: "Ongoing care", text: "Continuity, so your care evolves&nbsp;as&nbsp;you&nbsp;do.", ids: ["1:105", "1:106", "1:107"] },
    ]}
    image={{ src: "/img/approach.jpg", alt: "Two women talking in the clinic, one holding a folder" }}
    actions={{ pill: { label: "Learn more", href: "/our-approach", figma: "1:109" }, link: { label: "Book a consultation →", href: "#consultation", figma: "1:111" } }}
    figma={{ band: "approach", top: "2156.19", title: "1:95", image: "1:94" }}
  />
  {/* Results */}
  <ResultsHome />
  {/* Founder */}
  <FounderHome />
  {/* Journal */}
  <JournalHome />
  {/* Consultation */}
  <CtaBand />
</Layout>

---
import Layout from "@/layouts/BaseLayout.astro";
import ComponentList from "@/components/system/ComponentList.astro";
import ComponentSample from "@/components/system/ComponentSample.astro";
import ActionRow from "@/components/content/ActionRow.astro";
import CardRow from "@/components/content/CardRow.astro";
import ConcernIndex from "@/components/content/ConcernIndex.astro";
import IndexList from "@/components/content/IndexList.astro";
import Logo from "@/components/content/Logo.astro";
import ResultCaption from "@/components/content/ResultCaption.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import ConcernsHome from "@/components/section/ConcernsHome.astro";
import StepsSection from "@/components/section/StepsSection.astro";
import ResultsHome from "@/components/section/ResultsHome.astro";
import FounderHome from "@/components/section/FounderHome.astro";
import JournalHome from "@/components/section/JournalHome.astro";
import CtaBand from "@/components/section/CtaBand.astro";
import ConcernHead from "@/components/section/ConcernHead.astro";
import ConcernBody from "@/components/section/ConcernBody.astro";
import ProductsSection from "@/components/section/ProductsSection.astro";
import NotFound from "@/components/section/NotFound.astro";
import { getItems, getItem } from "@/utils/content";

/* the samples show the client's own copy: Melasma and the collections as they are */
const melasma = await getItem("concerns", "melasma");
const d = melasma?.data;
const treatments = await getItems("treatments");
const products = await getItems("products");
const steps = [
  { title: "Consultation", text: "Understanding your concerns, your priorities and your face." },
  { title: "Assessment", text: "A structured read of what is happening beneath the surface." },
];
---

<Layout title="Composantes" description="Les composantes faites pour ce site, chacune avec un exemple.">
  <ComponentList>
    <ComponentSample file="content/Logo.astro" note="Le logo du site, dans la couleur du texte de son thème.">
      <div class="site-grid"><Logo /></div>
    </ComponentSample>
    <ComponentSample file="content/ActionRow.astro" note="La rangée d'actions au pied d'une section : la pastille, puis le lien discret contre le bord droit.">
      <div class="site-grid">
        <ActionRow pill={{ label: "View all concerns", href: "/concerns" }} link={{ label: "Already know what you're looking for? Browse treatments →", href: "/treatments" }} />
      </div>
    </ComponentSample>
    <ComponentSample file="content/IndexList.astro" note="Une liste numérotée : un index, un titre, un texte.">
      <div class="site-grid"><IndexList steps={steps} /></div>
    </ComponentSample>
    <ComponentSample file="content/ConcernIndex.astro" note="La grande liste des préoccupations. Au survol, la ligne fonce et montre sa photo, son groupe et Learn more.">
      <div class="site-grid">
        <ConcernIndex items={[{ label: "Temple hollowing", category: "Structure", href: "/concerns" }, { label: "Melasma", category: "Surface", href: "/concerns/melasma", image: d?.image }]} />
      </div>
    </ComponentSample>
    <ComponentSample file="content/ResultCaption.astro" note="La légende d'un résultat : index, traitement, Before / After.">
      <div class="site-grid">
        <CardRow><li><ResultCaption index="[02]" name="Morpheus8" /></li></CardRow>
      </div>
    </ComponentSample>
    <ComponentSample file="content/CardRow.astro" note="Une rangée de cartes alignée sur la grille : trois colonnes sur ordinateur, une carte centrée en tablette, gauche, droite, pleine largeur en téléphone.">
      <div class="site-grid">
        <CardRow>
          {products.map((p) => <li class="text-style-h3">{p.data.name}</li>)}
        </CardRow>
      </div>
    </ComponentSample>
    <ComponentSample file="section/HeroHome.astro" note="L'ouverture de l'accueil."><HeroHome /></ComponentSample>
    <ComponentSample file="section/ConcernsHome.astro" note="Les préoccupations de l'accueil, lues dans la collection."><ConcernsHome /></ComponentSample>
    <ComponentSample file="section/StepsSection.astro" note="Les étapes avec leur photo : l'approche de l'accueil, How we treat d'une préoccupation.">
      <StepsSection title="The Dr Tranter Aesthetics <em>approach</em>" theme="mist" steps={steps} image={{ src: "/img/approach.jpg", alt: "" }} actions={{ pill: { label: "Learn more", href: "/our-approach" } }} />
    </ComponentSample>
    <ComponentSample file="section/ResultsHome.astro" note="Les résultats, lus dans la collection, dans la composition éparpillée du design."><ResultsHome /></ComponentSample>
    <ComponentSample file="section/FounderHome.astro" note="La fondatrice."><FounderHome /></ComponentSample>
    <ComponentSample file="section/JournalHome.astro" note="Les trois derniers articles du journal."><JournalHome /></ComponentSample>
    <ComponentSample file="section/CtaBand.astro" note="L'invitation de fin, sur chaque page."><CtaBand /></ComponentSample>
    {d?.statement && (
      <ComponentSample file="section/ConcernHead.astro" note="L'ouverture d'une préoccupation (Melasma).">
        <ConcernHead
          name={d.name}
          statement={d.statement}
          facts={[{ label: "Consultation", value: d.consultation ?? "" }, { label: "Assessed by", value: d.assessedBy ?? "" }]}
          image={d.image && { src: d.image, alt: d.imageAlt }}
        />
      </ComponentSample>
    )}
    <ComponentSample file="section/ConcernBody.astro" note="Le corps d'une préoccupation : ce qui se passe, ce qu'on considère, ce qu'on évalue en même temps.">
      <ConcernBody
        happening={{ text: d?.happening, steps: d?.factors }}
        recommended={treatments[0] && { title: treatments[0].data.name, text: d?.recommendedText ?? "", href: "/treatments", link: "View treatment →", image: treatments[0].data.image && { src: treatments[0].data.image } }}
        also={treatments.slice(1, 3).map((t) => ({ title: t.data.name, text: t.data.summary ?? "", href: "/treatments", link: "View treatment →", image: t.data.image && { src: t.data.image } }))}
      />
    </ComponentSample>
    <ComponentSample file="section/ProductsSection.astro" note="Les produits recommandés, lus dans la collection.">
      <ProductsSection products={products.map((p) => ({ id: p.id, name: p.data.name, text: p.data.text, image: p.data.image, imageAlt: p.data.imageAlt }))} />
    </ComponentSample>
    <ComponentSample file="section/NotFound.astro" note="La page introuvable."><NotFound /></ComponentSample>
  </ComponentList>
</Layout>

---
import Layout from "@/layouts/BaseLayout.astro";
import ComponentList from "@/components/system/ComponentList.astro";
import ComponentSample from "@/components/system/ComponentSample.astro";
import ActionRow from "@/components/content/ActionRow.astro";
import CardRow from "@/components/content/CardRow.astro";
import ConcernIndex from "@/components/content/ConcernIndex.astro";
import IndexList from "@/components/content/IndexList.astro";
import Logo from "@/components/content/Logo.astro";
import ResultCaption from "@/components/content/ResultCaption.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import ConcernsHome from "@/components/section/ConcernsHome.astro";
import StepsSection from "@/components/section/StepsSection.astro";
import ResultsHome from "@/components/section/ResultsHome.astro";
import PeopleHome from "@/components/section/PeopleHome.astro";
import JournalHome from "@/components/section/JournalHome.astro";
import JournalIndex from "@/components/section/JournalIndex.astro";
import JournalMore from "@/components/section/JournalMore.astro";
import GallerySection from "@/components/section/GallerySection.astro";
import TeamProfiles from "@/components/section/TeamProfiles.astro";
import Sheet from "@/components/content/Sheet.astro";
import ArticleBody from "@/components/section/ArticleBody.astro";
import ArticleCard from "@/components/content/ArticleCard.astro";
import Filters from "@/components/content/Filters.astro";
import CtaBand from "@/components/section/CtaBand.astro";
import ItemHead from "@/components/section/ItemHead.astro";
import ConcernBody from "@/components/section/ConcernBody.astro";
import ProductsSection from "@/components/section/ProductsSection.astro";
import NotFound from "@/components/section/NotFound.astro";
import PageHead from "@/components/section/PageHead.astro";
import TextSection from "@/components/section/TextSection.astro";
import DetailsSection from "@/components/section/DetailsSection.astro";
import CardGroup from "@/components/section/CardGroup.astro";
import Card from "@/components/content/Card.astro";
import { getItems, getItem } from "@/utils/content";

/* the samples show the client's own copy: Melasma and the collections as they are */
const melasma = await getItem("concerns", "melasma");
const d = melasma?.data;
const treatments = await getItems("treatments");
const products = await getItems("products");
const steps = [
  { title: "Consultation", text: "Understanding your concerns, your priorities and your face." },
  { title: "Assessment", text: "A structured read of what is happening beneath the surface." },
];
---

<Layout title="Composantes" description="Les composantes faites pour ce site, chacune avec un exemple.">
  <ComponentList>
    <ComponentSample file="content/Logo.astro" note="Le logo du site, dans la couleur du texte de son thème.">
      <div class="site-grid"><Logo /></div>
    </ComponentSample>
    <ComponentSample file="content/ActionRow.astro" note="La rangée d'actions au pied d'une section : la pastille, puis le lien discret contre le bord droit.">
      <div class="site-grid">
        <ActionRow pill={{ label: "View all concerns", href: "/concerns" }} link={{ label: "Already know what you're looking for? Browse treatments →", href: "/treatments" }} />
      </div>
    </ComponentSample>
    <ComponentSample file="content/IndexList.astro" note="Une liste numérotée : un index, un titre, un texte.">
      <div class="site-grid"><IndexList steps={steps} /></div>
    </ComponentSample>
    <ComponentSample file="content/ConcernIndex.astro" note="La grande liste des préoccupations. Au survol, la ligne fonce et montre sa photo, son groupe et Learn more.">
      <div class="site-grid">
        <ConcernIndex items={[{ label: "Temple hollowing", category: "Structure", href: "/concerns" }, { label: "Melasma", category: "Surface", href: "/concerns/melasma", image: d?.image }]} />
      </div>
    </ComponentSample>
    <ComponentSample file="content/ResultCaption.astro" note="La légende d'un résultat : index, traitement, Before / After.">
      <div class="site-grid">
        <CardRow><li><ResultCaption index="[02]" name="Morpheus8" /></li></CardRow>
      </div>
    </ComponentSample>
    <ComponentSample file="content/CardRow.astro" note="Une rangée de cartes alignée sur la grille : trois colonnes sur ordinateur, une carte centrée en tablette, en téléphone, trois colonnes sur quatre, à gauche puis à droite.">
      <div class="site-grid">
        <CardRow>
          {products.map((p) => <li class="text-style-h3">{p.data.name}</li>)}
        </CardRow>
      </div>
    </ComponentSample>
    <ComponentSample file="section/HeroHome.astro" note="L'ouverture de l'accueil."><HeroHome /></ComponentSample>
    <ComponentSample file="section/ConcernsHome.astro" note="Les préoccupations de l'accueil, lues dans la collection."><ConcernsHome /></ComponentSample>
    <ComponentSample file="section/StepsSection.astro" note="Les étapes avec leur photo : l'approche de l'accueil, How we treat d'une préoccupation.">
      <StepsSection title="The Dr Tranter Aesthetics <em>approach</em>" theme="mist" steps={steps} image={{ src: "/img/approach.jpg", alt: "" }} actions={{ pill: { label: "Learn more", href: "/approach" } }} />
    </ComponentSample>
    <ComponentSample file="section/ResultsHome.astro" note="Les résultats, lus dans la collection, dans la composition éparpillée du design."><ResultsHome /></ComponentSample>
    <ComponentSample file="section/PeopleHome.astro" note="La fondatrice, puis l'équipe, dans un même défilement : le titre et le portrait restent en place, le nom au carré est allumé et son portrait monte."><PeopleHome /></ComponentSample>
    <ComponentSample file="content/ArticleCard.astro" note="La carte d'un article : sa photo, son titre et « Read → » côte à côte, ou empilés avec sa date (More from the journal).">
      <CardRow>
        <ArticleCard id="pigmentation-vs-redness" title="Pigmentation and redness are not the same problem" />
        <ArticleCard id="pigmentation-vs-redness" title="Pigmentation and redness are not the same problem" date={new Date("2026-01-22")} layout="stacked" />
      </CardRow>
    </ComponentSample>
    <ComponentSample file="content/Filters.astro" note="Des pastilles qui montrent une catégorie des cartes d'une liste (pages Concerns, Treatments, Journal).">
      <div class="site-grid"><Filters label="Filter by topic" all="All" values={["Skin health", "The Approach", "Technology"]} /></div>
    </ComponentSample>
    <ComponentSample file="section/JournalIndex.astro" note="Les articles du Journal, quatre à la fois dans la composition de l'accueil, un filtre par sujet."><JournalIndex /></ComponentSample>
    <ComponentSample file="section/ArticleBody.astro" note="Le texte d'un article : ses titres à gauche, ses paragraphes au centre, le traitement dont il parle à droite, sa date au pied.">
      <ArticleBody body={"## Two mechanisms, one pass\n\nRadiofrequency microneedling works by combining two mechanisms in one device.\n\nThe result is a treatment that can address surface concerns and structural concerns in the same course."} treatment={{ name: "Morpheus8", text: "Addresses structure and surface together in a single treatment.", href: "/treatments/morpheus8" }} facts={[{ label: "Date", value: "22 January 2026" }]} />
    </ComponentSample>
    <ComponentSample file="section/JournalMore.astro" note="Trois autres articles sous un article, avec leur date."><JournalMore self="pigmentation-vs-redness" /></ComponentSample>
    <ComponentSample file="section/GallerySection.astro" note="Un titre, son texte et trois photos disposées comme le Journal (The space, The Clinic).">
      <GallerySection theme="mist" title="The space" text="The clinic was designed to feel considered rather than clinical." images={[{ src: "/img/clinic-space-room.jpg" }, { src: "/img/clinic-space-stool.jpg" }, { src: "/img/clinic-space-bed.jpg" }]} />
    </ComponentSample>
    <ComponentSample file="content/Sheet.astro" note="Une feuille par-dessus la page (la fiche d'un membre, Send an enquiry) : un lien vers son adresse l'ouvre, Back ou Échap la ferment.">
      <p class="text-style-main"><a href="#sheet-sample">Open the sample sheet</a></p>
      <Sheet id="sheet-sample" labelledby="sheet-sample-title"><h2 class="text-style-h2" id="sheet-sample-title">A sheet over the page</h2></Sheet>
    </ComponentSample>
    <ComponentSample file="section/TeamProfiles.astro" note="Le profil d'un membre de l'équipe, ouvert par-dessus Our team (Full profile ou son nom). Lien d'essai : #team-sarah-tranter.">
      <p class="text-style-main"><a href="#team-sarah-tranter">Open Dr Sarah Tranter's profile</a></p>
      <TeamProfiles />
    </ComponentSample>
    <ComponentSample file="section/JournalHome.astro" note="Quatre articles du journal, chacun à sa taille, dans la composition du design."><JournalHome /></ComponentSample>
    <ComponentSample file="section/CtaBand.astro" note="L'invitation de fin, sur chaque page."><CtaBand /></ComponentSample>
    {d?.statement && (
      <ComponentSample file="section/ItemHead.astro" note="L'ouverture d'une page de préoccupation ou de traitement : retour, nom, fil, énoncé, photo, faits (Melasma).">
        <ItemHead
          name={d.name}
          statement={d.statement}
          facts={[{ label: "Consultation", value: d.consultation ?? "" }, { label: "Assessed by", value: d.assessedBy ?? "" }]}
          image={d.image && { src: d.image, alt: d.imageAlt }}
        />
      </ComponentSample>
    )}
    <ComponentSample file="section/ConcernBody.astro" note="Le corps d'une préoccupation : ce qui se passe, ce qu'on considère, ce qu'on évalue en même temps.">
      <ConcernBody
        happening={{ text: d?.happening, steps: d?.factors }}
        recommended={treatments[0] && { title: treatments[0].data.name, text: d?.recommendedText ?? "", href: "/treatments", link: "View treatment →", image: treatments[0].data.image && { src: treatments[0].data.image } }}
        also={treatments.slice(1, 3).map((t) => ({ title: t.data.name, text: t.data.summary ?? "", href: "/treatments", link: "View treatment →", image: t.data.image && { src: t.data.image } }))}
      />
    </ComponentSample>
    <ComponentSample file="section/ProductsSection.astro" note="Les produits recommandés, lus dans la collection.">
      <ProductsSection products={products.map((p) => ({ id: p.id, name: p.data.name, text: p.data.text, image: p.data.image, imageAlt: p.data.imageAlt }))} />
    </ComponentSample>
    <ComponentSample file="section/PageHead.astro" note="L'ouverture d'une page sous la navigation : le petit carré, puis la phrase sur le rail principal (Our Approach).">
      <PageHead title="Every <em>treatment</em> here follows the same four stages: <em>consultation, assessment, planning, and ongoing care.</em>" />
    </ComponentSample>
    <ComponentSample file="section/DetailsSection.astro" note="Un titre et des paires nom et texte, deux par rangée, un filet entre les groupes (What to expect d'un traitement).">
      <DetailsSection
        theme="light"
        title="What <em>to expect</em>"
        groups={[
          { items: [{ title: "Who it suits", text: "Patients with mild to moderate concerns who want a considered option without surgery." }, { title: "When it may not be suitable", text: "Active skin infections, certain pigmentary conditions, pacemakers or implanted devices, or pregnancy." }] },
          { kind: "names", items: [{ title: "Before", text: "Skin is cleansed and a topical anaesthetic applied to minimise discomfort." }, { title: "Risks", text: "Risks may include prolonged redness, pigment changes or, rarely, infection; discussed in full at consultation.", action: { label: "Read more →", href: "/legal/risks-and-complications" } }] },
        ]}
      />
    </ComponentSample>
    <ComponentSample file="section/TextSection.astro" note="Un titre, son texte sur le rail principal, et une courte liste sans numéros ou un lien à droite (Our Approach).">
      <TextSection theme="stone" title="Where we <em>focus</em>" text="Our focus is deliberately narrow: the lower face, and how it ages." list={[{ title: "Lower-face tightening", text: "The concern we are most focused on." }, { title: "Skin rejuvenation", text: "Tone, texture and quality of the surface." }]} />
      <TextSection theme="mist" title="Structure, Surface and Cohesion" text="We consider the face in three parts." action={{ label: "Browse Structure and Surface concerns →", href: "/concerns" }} />
    </ComponentSample>
    <ComponentSample file="content/Card.astro" note="Une carte : la photo à 1,45, le nom en capitales, une ligne, le lien. Le cadre reste vide tant que la photo n'est pas là.">
      <Card title="Volume loss and hollowing" text="The cheeks, temples and jawline often lose definition before the skin itself shows visible change." href="/concerns/volume-loss" link="View concern →" />
    </ComponentSample>
    <ComponentSample file="section/CardGroup.astro" note="Un groupe de cartes (pages Concerns et Treatments) : son nom à la marge avec le carré, ses cartes deux par rangée, des filtres sous le nom au besoin.">
      <CardGroup label="Filter by" collection="concerns" noun="Concern" link="View concern →" filters={{ all: "All concerns", values: ["Structure"] }} items={[{ id: "volume-loss", name: "Volume loss and hollowing", summary: "The cheeks, temples and jawline often lose definition before the skin itself shows visible change.", href: "/concerns/volume-loss", category: "Structure" }, { id: "jawline-and-chin", name: "Jawline and chin definition", summary: "Definition through the jawline often softens gradually over time." }]} />
    </ComponentSample>
    <ComponentSample file="section/NotFound.astro" note="La page introuvable."><NotFound /></ComponentSample>
  </ComponentList>
</Layout>

---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import Loader from "@/components/system/Loader.astro";
import PageTransitions from "@/components/system/PageTransitions.astro";
import SmoothScroll from "@/components/system/SmoothScroll.astro";
import CopyCase from "@/components/system/CopyCase.astro";
import CutSwap from "@/components/system/CutSwap.astro";
import Registration from "@/components/global/Registration.astro";
import Booking from "@/components/global/Booking.astro";
import Enquiry from "@/components/global/Enquiry.astro";
import Tracking from "@/components/system/Tracking.astro";
import ConsentBanner from "@/components/global/ConsentBanner.astro";
import type { SeoProps } from "@/types.ts";
import { SITE_LOCALE } from "@/consts.ts";
import { finishes } from "@/utils/finishes.ts";
import config from "../../op.config.json";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
  /** Set to `false` for a page with no bar (the style sheet); `menu` for a page with its own head that keeps the menu's
   * button alone (the concern pages, Sam, Nov 24). */
  nav?: boolean | "menu";
  /** Set to `false` for a page that shows the logo close above the footer (the page not found, Sam, Nov 24). */
  footerLogo?: boolean;
  /** The nav's colours, those of the page's opening: dark (the home), light (a page opening on sand). */
  navTheme?: "dark" | "light";
};

const { theme = "inherit", overlap = false, nav = true, navTheme = "dark", footerLogo = true, ...seo } = Astro.props;

/* The finishing touches, each off until op.config.json turns it on (src/utils/finishes.ts): the loading screen, the
   transition between pages, the smooth scroll. A "custom" one without its file stands in as its first preset. */
const own = Object.keys(
  import.meta.glob(
    "/src/components/system/{LoaderCustom,TransitionCustom}.astro",
  ),
);
const has = (name: string) => own.some((f) => f.endsWith(`/${name}.astro`));
const finish = finishes(config);
const loader =
  finish.loader === "custom" && !has("LoaderCustom") ? "logo" : finish.loader;
const transition =
  finish.transition === "custom" && !has("TransitionCustom")
    ? "slide"
    : finish.transition;
const { smoothScroll } = finish;
---

<!doctype html>
<html
  lang={SITE_LOCALE}
  class:list={[theme !== "inherit" && `theme-${theme}`]}
  data-page-transition={transition ?? undefined}
>
  <head>
    <BaseHead {...seo} />
    <Tracking />
    {loader && <Loader part="head" preset={loader} />}
    {transition && <PageTransitions part="head" preset={transition} />}
    {
      smoothScroll && (
        <SmoothScroll
          intensity={smoothScroll.intensity}
          touch={smoothScroll.touch}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    {loader && <Loader part="cover" preset={loader} />}
    {transition && <PageTransitions part="body" preset={transition} />}
    <SkipLink label={SITE_LOCALE.startsWith("fr") ? "Aller au contenu" : "Skip to content"} />
    <div class="site-top">
      <Registration render={nav !== false} />
      <Nav overlap={overlap} render={nav !== false} quiet={nav === "menu"} theme={navTheme} />
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer logo={footerLogo} />
    <Booking />
    <Enquiry />
    <ConsentBanner />
    <CopyCase />
    <CutSwap />
  </body>
</html>

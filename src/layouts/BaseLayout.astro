---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import SiteHeader from "@/components/content/SiteHeader.astro";
import SiteFooter from "@/components/content/SiteFooter.astro";
import ClinicSchema from "@/components/system/ClinicSchema.astro";
import Loader from "@/components/system/Loader.astro";
import PageTransitions from "@/components/system/PageTransitions.astro";
import SmoothScroll from "@/components/system/SmoothScroll.astro";
import type { SeoProps, Theme } from "@/types.ts";
import { SITE_LOCALE } from "@/consts.ts";
import { finishes } from "@/utils/finishes.ts";
import config from "../../op.config.json";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: Theme;
};

const { theme = "inherit", ...seo } = Astro.props;

/* The finishing touches, each off until op.config.json turns it on (src/utils/finishes.ts): the loading screen, the
   transition between pages, the smooth scroll. A "custom" one without its file stands in as its first preset. */
const own = Object.keys(
  import.meta.glob(
    "/src/components/system/{LoaderCustom,TransitionCustom}.astro",
  ),
);
const has = (name: string) => own.some((f) => f.endsWith(`/${name}.astro`));
const finish = finishes(config);
const loader =
  finish.loader === "custom" && !has("LoaderCustom") ? "logo" : finish.loader;
const transition =
  finish.transition === "custom" && !has("TransitionCustom")
    ? "slide"
    : finish.transition;
const { smoothScroll } = finish;
---

<!doctype html>
<html
  lang={SITE_LOCALE}
  class:list={[theme !== "inherit" && `theme-${theme}`]}
  data-page-transition={transition ?? undefined}
>
  <head>
    <BaseHead {...seo} />
    {loader && <Loader part="head" preset={loader} />}
    {transition && <PageTransitions part="head" preset={transition} />}
    {
      smoothScroll && (
        <SmoothScroll
          intensity={smoothScroll.intensity}
          touch={smoothScroll.touch}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    {loader && <Loader part="cover" preset={loader} />}
    {transition && <PageTransitions part="body" preset={transition} />}
    <SkipLink label="Skip to content" />
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <ClinicSchema />
  </body>
</html>

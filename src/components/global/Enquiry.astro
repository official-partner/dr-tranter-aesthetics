---
import Sheet from "@/components/content/Sheet.astro";
import { clinic } from "@/data/clinic";
/* Send an enquiry (Figma 4001:265), over every page: Contact, Careers, The Clinic's « Send an enquiry » and the
   vouchers open it. The form is the clinic's Pabau form, not one of the site's (Mia Endozo's tracking guide, step 7:
   its enquiries become leads in Pabau, which no form of the site could send). Opened from Careers, it says so first
   (brief C5). Pabau's own embed code, once the clinic sends it, replaces the frame. On the sand, the form on the
   stone (Sam, Nov 26: « light mode, un mix de light et de blanc »). */
---

<Sheet id="enquiry" also={["enquiry-careers"]} labelledby="enquiry-title" theme="light" class="enquiry_wrap">
  <h2 class="enquiry_title text-style-h2" id="enquiry-title">Send an enquiry</h2>
  <hr class="sheet_rule enquiry_rule" />
  {/* the whole enquiry on the stone, edge to edge down to the panel's foot (Sam, Nov 26, comment 37) */}
  <div class="enquiry_band theme-stone">
    <p class="enquiry_label text-style-label">Enquiry</p>
    <div class="enquiry_body">
      <p class="enquiry_careers text-style-main">We're always glad to hear from experienced practitioners who share the clinic's approach to considered, evidence-led care. Send us your details and a little about your background below.</p>
      <iframe class="enquiry_form" src={clinic.enquiryForm} title="Enquiry form" loading="lazy"></iframe>
    </div>
  </div>
</Sheet>

<style is:global>
  @layer components {
    .enquiry_title,
    .enquiry_label,
    .enquiry_body {
      grid-column: margin / end;
    }
    /* the panel ends on the band: no sand under it */
    .enquiry_wrap .sheet_layout {
      padding-bottom: 0;
    }
    /* the band runs to the panel's edges (its margin taken back, its columns those of the sheet) and starts right on
       the hairline */
    .enquiry_band {
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-7);
      margin-top: calc(var(--space-7) * -1);
      margin-inline: calc(var(--site-margin) * -1);
      padding: var(--section-padding) var(--site-margin);
    }
    .enquiry_body {
      display: grid;
      gap: var(--space-7);
    }
    .enquiry_careers {
      display: none;
      max-width: 52ch;
    }
    .enquiry_wrap[data-via="enquiry-careers"] .enquiry_careers {
      display: block;
    }
    .enquiry_form {
      width: 100%;
      height: 44rem;
      border: 0;
      background: var(--background);
    }
    @media (width >= 48rem) {
      .enquiry_title {
        grid-row: 1;
        grid-column: main / end;
      }
      .enquiry_rule {
        grid-row: 2;
      }
      .enquiry_band {
        grid-row: 3;
      }
      .enquiry_label,
      .enquiry_body {
        grid-row: 1;
      }
      .enquiry_label {
        grid-column: margin / main;
      }
      .enquiry_body {
        grid-column: main / end;
      }
    }
  }
</style>

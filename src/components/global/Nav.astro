---
import Logo from "@/components/content/Logo.astro";
import Button from "@/components/Button.astro";
import Menu from "@/components/global/Menu.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
  /** The colours of the page's opening it sits on: dark (the home's ink), light (a page opening on sand). */
  theme?: "dark" | "light";
  /** The menu's button alone, for a page with its own head (a concern's page): the logo and the pill come in with
   * the menu. */
  quiet?: boolean;
}

const { render = true, theme = "dark", quiet = false } = Astro.props;
import { clinic } from "@/data/clinic";
---

{
  render && (
    <header class:list={["nav_wrap", `theme-${theme}`]} data-figma-band="header" data-nav-theme={theme} data-nav-quiet={quiet ? "" : undefined}>
      <Menu />
      <div class="nav_inner site-grid">
        <Logo class="nav_logo" data-figma="1:65" />
        <div class="nav_actions at-end">
          <Button element="link" href={clinic.booking} data-figma="1:67">
            Book a consultation
          </Button>
          <button class="nav_toggle" type="button" aria-label="Open the menu" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
            <span class="nav_toggle_line" />
            <span class="nav_toggle_line" />
            <span class="nav_toggle_line" />
          </button>
          <span class="nav_toggle_space" aria-hidden="true" data-figma="1:69" />
        </div>
      </div>
    </header>
  )
}

<style is:global>
  @layer components {
    .nav_wrap {
      position: absolute;
      inset: 0 0 auto;
      z-index: 10;
      padding-top: var(--site-margin);
      background-color: transparent;
    }
    /* the bar over the open menu */
    .nav_inner {
      position: relative;
      align-items: start;
    }
    /* the bar takes the menu's colours as the curtain passes under it, and its own back as it lifts (the theme class is
       swapped by the script below; the colours follow it here) */
    html:is([data-menu="open"], [data-menu="closing"]) :is(.nav_inner, .nav_inner *):not(.nav_toggle_line) {
      transition:
        color var(--hover-duration) var(--hover-ease) var(--_bar-delay, 0s),
        border-color var(--hover-duration) var(--hover-ease) var(--_bar-delay, 0s),
        background-color var(--hover-duration) var(--hover-ease) var(--_bar-delay, 0s);
    }
    html[data-menu="open"] :is(.nav_inner, .nav_inner *) {
      --_bar-delay: var(--menu-bar-delay);
    }
    /* opened from further down the page, where the bar is not on screen: its logo and its pill come in with the menu
       and go with it, never popping in or out */
    html[data-menu-away] :is(.nav_logo, .nav_actions > .button_wrap) {
      opacity: 0;
      transition: none;
    }
    html[data-menu-away][data-menu="closing"] :is(.nav_logo, .nav_actions > .button_wrap) {
      transition: opacity var(--menu-line-close-duration) var(--menu-close-ease);
    }
    html[data-menu-away][data-menu="open"] :is(.nav_logo, .nav_actions > .button_wrap) {
      opacity: 1;
      transition: opacity var(--hover-duration) var(--hover-ease) var(--menu-bar-delay);
    }
    /* A page with its own head (a concern's page: Back, the name, the crumb) has the menu's button alone in its bar
       (Sam, comment 11, Nov 24: « avoir le menu burger sur cette page aussi »): the logo and the pill come in with the
       menu, as when it is opened from down the page (the script marks it away) */
    .nav_wrap[data-nav-quiet] {
      /* the page's own head stays within reach under the bar: only the button takes the pointer */
      pointer-events: none;
      & .nav_toggle {
        pointer-events: auto;
      }
      & :is(.nav_logo, .nav_actions > .button_wrap) {
        visibility: hidden;
      }
    }
    html[data-menu] .nav_wrap[data-nav-quiet] {
      pointer-events: auto;
      & :is(.nav_logo, .nav_actions > .button_wrap) {
        visibility: visible;
      }
    }
    .nav_logo {
      grid-column: margin / span 2;
    }
    .nav_actions {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      @media (width < 48rem) {
        grid-row: 1;
        grid-column: span 2 / end;
        justify-self: end;
      }
    }
    /* The menu's button stays on screen as the page scrolls (Sam, Nov 20, 13:17), where the bar puts it: the script
       below fixes it at the place its stand-in keeps in the bar, and gives it the theme of the section under it, so
       it reads on a light ground and on a dark one. */
    .nav_toggle {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: var(--burger);
      aspect-ratio: 18.53 / 11.77;
      color: var(--text);
      transition: color var(--hover-duration) var(--hover-ease);
      /* a finger's room around three thin lines */
      &::before {
        content: "";
        position: absolute;
        inset: calc(var(--space-4) * -1);
      }
      /* its theme class gives it the section's text colour only, never the section's ground (comment 2, Nov 20: a
         small rectangle showed under the lines as the menu opened) */
      &[class*="theme-"] {
        background-color: transparent;
      }
      &[data-fixed] {
        position: fixed;
        top: var(--_toggle-top);
        right: var(--_toggle-right);
      }
    }
    .nav_toggle_space {
      display: none;
      width: var(--burger);
      aspect-ratio: 18.53 / 11.77;
      .nav_toggle[data-fixed] + & {
        display: block;
      }
    }
    /* Three lines to a cross, in two steps (Sam, 13:17). Its job: answer the click and say what the button now does.
       Opening: the outer lines meet on the middle one, which closes on its centre, then they turn into the cross.
       Closing runs it back: the cross unturns, then the lines part. Each step --burger-duration on the out curve, the
       second starting as the first settles. */
    .nav_toggle_line {
      display: block;
      height: var(--border-width);
      background-color: currentcolor;
      transform-origin: center;
      --_step: calc(var(--burger-duration) * 0.7);
      --_meet: calc(var(--burger) * 11.77 / 18.53 / 2 - var(--border-width) / 2);
      /* to the three lines: unturn, then part */
      transition:
        rotate var(--burger-duration) var(--ease-smooth),
        translate var(--burger-duration) var(--ease-smooth) var(--_step),
        scale var(--burger-duration) var(--ease-smooth) var(--_step);
    }
    .nav_toggle[aria-expanded="true"] .nav_toggle_line {
      /* to the cross: meet, then turn */
      transition:
        translate var(--burger-duration) var(--ease-smooth),
        scale var(--burger-duration) var(--ease-smooth),
        rotate var(--burger-duration) var(--ease-smooth) var(--_step);
      &:nth-child(1) {
        translate: 0 var(--_meet);
        rotate: 45deg;
      }
      &:nth-child(2) {
        scale: 0 1;
      }
      &:nth-child(3) {
        translate: 0 calc(var(--_meet) * -1);
        rotate: -45deg;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .nav_toggle_line,
      .nav_toggle[aria-expanded="true"] .nav_toggle_line {
        transition: none;
      }
    }
  }
</style>

<script>
  import { onPage } from "@/utils/page";
  import { pageLenis } from "@/utils/smooth-scroll";

  /* a page change's motion over: the button takes the colours of what is under it now (nav:retint, below) */
  document.addEventListener("astro:before-swap", (e) => {
    const vt = (e as Event & { viewTransition?: { finished: Promise<void> } }).viewTransition;
    vt?.finished.then(() => dispatchEvent(new Event("nav:retint"))).catch(() => undefined);
  });

  /* The menu: opened and closed by the nav's button, closed by Escape, the scrim or a link; the page behind it inert
     and still; the nav's bar takes the menu's colours while it is open; focus goes in, then back to the button. The
     button itself stays on screen at every scroll, in the colours of the section under it. */
  onPage((signal) => {
    const root = document.documentElement;
    const nav = document.querySelector<HTMLElement>(".nav_wrap");
    const menu = document.getElementById("site-menu");
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const scrim = document.querySelector<HTMLElement>("[data-menu-scrim]");
    if (!nav || !menu || !toggle) return;
    const page = () => [...document.querySelectorAll<HTMLElement>("main, footer")];
    const original = nav.dataset.navTheme ?? "dark";

    /* a duration token in ms, whether it is written 650ms or .65s */
    const ms = (name: string) => {
      const v = getComputedStyle(root).getPropertyValue(name).trim();
      return (parseFloat(v) || 0) * (v.endsWith("ms") ? 1 : v.endsWith("s") ? 1000 : 1);
    };
    let timers: number[] = [];
    const clear = () => { timers.forEach((t) => window.clearTimeout(t)); timers = []; };
    const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
    const theme = (menuColours: boolean) => {
      nav.classList.toggle(`theme-${original}`, !menuColours);
      nav.classList.toggle("theme-mist", menuColours);
    };

    /* The button's place: fixed where its stand-in sits in the bar (the bar is at the page's top) */
    const space = toggle.nextElementSibling as HTMLElement | null;
    const place = () => {
      if (!space || root.dataset.menu) return;
      toggle.dataset.fixed = "";
      const r = space.getBoundingClientRect();
      toggle.style.setProperty("--_toggle-top", `${r.top + scrollY}px`);
      toggle.style.setProperty("--_toggle-right", `${root.clientWidth - r.right}px`);
    };
    /* The button's colours: the theme of the section under it; the menu's own while the menu is open (`back`: the menu
       is lifting past it, the page's colours come back) */
    const tint = (back = false) => {
      const old = [...toggle.classList].find((c) => c.startsWith("theme-"));
      let name: string | undefined;
      if (!root.dataset.menu || back) {
        const r = toggle.getBoundingClientRect();
        const under = document.elementsFromPoint(r.x + r.width / 2, r.y + r.height / 2).find((el) => !nav.contains(el));
        const host = under?.closest('[class*="theme-"]');
        name = [...(host?.classList ?? [])].find((c) => c.startsWith("theme-"));
        /* nothing themed under it (a page change's snapshot covers the page while it runs): keep its colours until
           the page shows again, never a guess that could match the ground (Sam, Nov 26: « le menu burger... invisible ») */
        if (!name) {
          if (old) return;
          name = "theme-light";
        }
      }
      if (old === name) return;
      if (old) toggle.classList.remove(old);
      if (name) toggle.classList.add(name);
    };
    let frame = 0;
    const follow = () => { if (!frame) frame = requestAnimationFrame(() => { frame = 0; tint(); }); };
    place();
    tint();
    document.fonts?.ready.then(() => { place(); tint(); });
    window.addEventListener("scroll", follow, { signal, passive: true });
    /* and again once a page change, the loading screen or the arriving page's motion is over: while they run, what is
       under the button is their cover, not the page */
    window.addEventListener("nav:retint", follow, { signal });
    const watch = new MutationObserver(follow);
    watch.observe(root, { attributes: true, attributeFilter: ["data-loader", "data-arrive", "data-page-transition"] });
    signal.addEventListener("abort", () => watch.disconnect());
    [300, 1200].forEach((t) => timers.push(window.setTimeout(follow, t)));
    window.addEventListener("resize", () => { place(); follow(); }, { signal });
    signal.addEventListener("abort", () => cancelAnimationFrame(frame));

    const set = (open: boolean) => {
      clear();
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close the menu" : "Open the menu");
      page().forEach((el) => (el.inert = open));
      const lenis = pageLenis();
      if (lenis) open ? lenis.stop() : lenis.start();
      if (open) {
        if (nav.getBoundingClientRect().bottom <= 0 || nav.hasAttribute("data-nav-quiet")) root.dataset.menuAway = "";
        menu.hidden = false;
        /* one frame with the panel shown and closed, so its curtain runs from the top */
        requestAnimationFrame(() => requestAnimationFrame(() => {
          if (toggle.getAttribute("aria-expanded") !== "true") return;
          root.dataset.menu = "open";
          theme(true);
          tint();
        }));
        menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
      } else {
        if (root.dataset.menu !== "open") { menu.hidden = true; delete root.dataset.menu; delete root.dataset.menuAway; theme(false); return; }
        toggle.focus({ preventScroll: true });
        const wait = reduced() ? 0 : ms("--menu-close-delay");
        const close = reduced() ? 0 : ms("--menu-close-duration");
        root.dataset.menu = "closing";
        /* the bar gets its colours back as the curtain lifts past it, then the panel leaves the tab order */
        timers.push(window.setTimeout(() => { theme(false); tint(true); }, wait + close * 0.8));
        timers.push(window.setTimeout(() => {
          delete root.dataset.menu;
          delete root.dataset.menuAway;
          menu.hidden = true;
          tint();
        }, wait + close + 60));
      }
    };

    /* the menu's photo loads as soon as the button is approached, so it is there when the curtain uncovers it */
    const warm = () => menu.querySelectorAll<HTMLImageElement>("img[loading='lazy']").forEach((img) => (img.loading = "eager"));
    ["pointerenter", "focusin", "touchstart"].forEach((t) => toggle.addEventListener(t, warm, { signal, once: true, passive: true }));
    toggle.addEventListener("click", () => set(toggle.getAttribute("aria-expanded") !== "true"), { signal });
    scrim?.addEventListener("click", () => set(false), { signal });
    /* a link of the menu: the page change's curtain rises over the open menu, which leaves with its page (TransitionCustom);
       without the router (a new tab, a link it does not follow) it closes as usual */
    menu.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest("a");
      if (!a) return;
      /* a place on this page (a pop-up: Contact, Careers) is no page change: the menu closes */
      const here = a.pathname === location.pathname && a.search === location.search && Boolean(a.hash);
      const routed = root.dataset.pageTransition && a.origin === location.origin && !here && !a.target && !a.hasAttribute("download") && !a.hasAttribute("data-astro-reload");
      if (routed && !(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)) return;
      set(false);
    }, { signal });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && root.dataset.menu === "open") set(false); }, { signal });
    signal.addEventListener("abort", () => { clear(); if (root.dataset.menu) { delete root.dataset.menu; delete root.dataset.menuAway; menu.hidden = true; theme(false); page().forEach((el) => (el.inert = false)); pageLenis()?.start(); } });
  });
</script>


---
import { clinicLinks, connectLinks, concernLinks, isHere } from "@/utils/site-links";

const { structure, surface } = await concernLinks();
const path = Astro.url.pathname;
const groups = [
  { name: "Structure", key: "structure", links: structure.map((c) => ({ label: c.name, href: c.href, id: c.id })), concerns: true },
  { name: "Surface", key: "surface", links: surface.map((c) => ({ label: c.name, href: c.href, id: c.id })), concerns: true },
  { name: "The Clinic", key: "clinic", links: clinicLinks },
  { name: "Connect", key: "connect", links: connectLinks },
];
---

{/* The menu (Figma 59:191, its note: « slides the menu down from the top of the screen, over the page you were on,
    which dims behind it until the menu is closed »). Inside the nav's header, under its bar; opened by Nav's button. */}
<div class="menu_scrim" data-menu-scrim aria-hidden="true"></div>
<div class="menu_wrap theme-mist" id="site-menu" data-menu-panel hidden>
  <div class="menu_layout site-grid">
    <nav class="menu_groups" aria-label="Menu">
      {groups.map((g, gi) => (
        <div class:list={["menu_group stack gap-4", `is-${g.key}`]} style={`--g: ${gi}`}>
          <p class="text-style-label"><span class="menu_mask"><span class="menu_rise" style="--i: 0">{g.name}</span></span></p>
          <ul class="link-list text-style-list" data-op-list={g.concerns ? "concerns" : undefined} data-op-source={g.concerns ? "astro:concerns" : undefined}>
            {g.links.map((l, i) => (
              <li data-op-item={g.concerns ? (l as { id?: string }).id : undefined}>
                <a href={l.href} aria-current={isHere(l.href, path, g.links) ? "page" : undefined}><span class="menu_mask"><span class="menu_rise" style={`--i: ${i + 1}`} data-op-field={g.concerns ? "name" : undefined}>{l.label}</span></span></a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <div class="menu_media media">
      <img class="menu_image" src="/img/approach.jpg" alt="Two women talking in the clinic" width="402" height="498" loading="lazy" />
    </div>
  </div>
</div>

<style is:global>
  @layer components {
    /* The menu's motion (Sam, Nov 20: « un clip masque, un peu plus lent, premium »). Its job: show where the menu
       comes from and let its links arrive in reading order. One thing at a time:
       1. the click answers at once: the cross forms (Nav, --open-duration on the out curve);
       2. a curtain uncovers the panel from the top (a clip, --menu-open-duration on the arrive curve), its content
          drifting down into place under it and the photo settling from a slight zoom; the page dims behind;
       3. once the curtain is well down, each group's name and links rise from their masks, group by group, in order.
       Closing is a little quicker: the links leave upward under their masks, then the curtain lifts after them
       (--menu-close-delay, --menu-close-duration). Every value is a token
       of base.css (--menu-*). Reduced motion: no travel, it opens and closes at once. */

    /* the page dims behind the open menu */
    .menu_scrim {
      position: fixed;
      inset: 0;
      background-color: color-mix(in srgb, var(--ink) var(--tone-faint), transparent);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--menu-close-duration) var(--menu-close-ease),
        visibility 0s linear var(--menu-close-duration);
    }
    /* the panel slides down from the top, under the nav's bar */
    .menu_wrap {
      position: fixed;
      inset: 0 0 auto;
      max-height: 100svh;
      overflow-y: auto;
      /* the first labels just under the nav's bar (the Figma's 92 at 1728) */
      padding-top: calc(var(--site-margin) + var(--space-8));
      /* as much below the last links as above the first labels; on a large screen the photo ends it, on the margin */
      padding-bottom: calc(var(--site-margin) + var(--space-8));
      @media (width >= 64rem) {
        padding-bottom: var(--site-margin);
      }
      background-color: var(--background);
      color: var(--text);
      /* the curtain: closed at its top edge, the panel itself never moves */
      clip-path: inset(0 0 100% 0);
      transition: clip-path var(--menu-close-duration) var(--menu-close-ease) var(--menu-close-delay);
      &[hidden] {
        display: block;
        visibility: hidden;
      }
    }
    /* its content drifts down into place under the curtain */
    .menu_layout {
      translate: 0 var(--menu-shift);
      transition: translate var(--menu-close-duration) var(--menu-close-ease) var(--menu-close-delay);
    }
    .menu_image {
      /* the menu's own settle, never the scroll's (project.css) */
      animation: none;
      scale: var(--menu-image-scale);
      transition: scale var(--menu-close-duration) var(--menu-close-ease) var(--menu-close-delay);
    }
    /* a name or a link rises from its mask (a little room below for the descenders) */
    .menu_mask {
      display: block;
      overflow: clip;
      padding-bottom: 0.15em;
      margin-bottom: -0.15em;
    }
    .menu_rise {
      display: block;
      translate: 0 110%;
      opacity: 0;
      /* closed: back under its mask at once, ready to rise again (nothing shows: the curtain is up) */
      transition: none;
    }
    /* closing (Sam, Nov 20, 13:17: « le texte disparaît trop vite au close »): the names and links leave upward under
       their masks, in the order they came, as the curtain starts to lift after them */
    html[data-menu="closing"] .menu_rise {
      translate: 0 -110%;
      opacity: 1;
      transition: translate var(--menu-line-close-duration) var(--menu-close-ease)
        calc((var(--g, 0) * 2 + var(--i, 0)) * var(--menu-close-stagger));
    }
    html[data-menu="open"] {
      overflow: hidden;
      & .menu_wrap {
        clip-path: inset(0 0 0 0);
        transition: clip-path var(--menu-open-duration) var(--menu-open-ease);
      }
      & .menu_layout {
        translate: 0 0;
        transition: translate var(--menu-open-duration) var(--menu-open-ease);
      }
      & .menu_image {
        scale: 1;
        transition: scale var(--menu-image-duration) var(--menu-line-ease);
      }
      & .menu_rise {
        translate: 0 0;
        opacity: 1;
        transition:
          translate var(--menu-line-duration) var(--menu-line-ease) var(--_rise-delay),
          opacity 0s linear var(--_rise-delay);
        --_rise-delay: calc(var(--menu-line-delay) + var(--g, 0) * var(--menu-group-stagger) + var(--i, 0) * var(--menu-stagger));
      }
      & .menu_scrim {
        opacity: 1;
        visibility: visible;
        transition: opacity var(--menu-open-duration) var(--menu-line-ease);
      }
      & .nav_wrap {
        position: fixed;
      }
    }
    /* the menu still covers the page while its curtain lifts */
    html[data-menu="closing"] .nav_wrap {
      position: fixed;
    }
    /* reduced motion: no curtain, no rise, no drift; it shows and goes at once */
    @media (prefers-reduced-motion: reduce) {
      .menu_wrap,
      html[data-menu="open"] .menu_wrap {
        clip-path: none;
        opacity: 0;
        transition: none;
      }
      html[data-menu="open"] .menu_wrap {
        opacity: 1;
      }
      .menu_layout,
      .menu_image,
      .menu_rise {
        translate: none;
        scale: none;
      }
      .menu_rise,
      html[data-menu="open"] .menu_rise {
        opacity: 1;
        transition: none;
      }
    }
    .menu_groups {
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-8);
    }
    /* phone: the groups two by two, as the footer's */
    .menu_group {
      grid-column: margin / span 2;
      @media (width < 48rem) {
        &:nth-child(even) {
          grid-column: span 2 / end;
        }
      }
    }
    .menu_media {
      display: none;
    }
    /* tablet: the concerns on the content columns, the clinic's links on the last two */
    @media (48rem <= width < 64rem) {
      .menu_group {
        grid-column: main / span 2;
        &.is-surface {
          grid-row: 2;
        }
        &.is-clinic,
        &.is-connect {
          grid-column: aside / end;
        }
        &.is-clinic {
          grid-row: 1;
        }
        &.is-connect {
          grid-row: 2;
        }
      }
    }
    /* computer: the concerns from the main rail, the clinic's links from the half rail, the photo on the aside */
    @media (width >= 64rem) {
      .menu_groups {
        grid-column: margin / aside;
        grid-row: 1;
      }
      .menu_group {
        grid-column: main / span 3;
        &.is-structure {
          grid-row: 1;
        }
        &.is-surface {
          grid-row: 2;
        }
        &.is-clinic,
        &.is-connect {
          grid-column: half / span 2;
        }
        &.is-clinic {
          grid-row: 1;
        }
        &.is-connect {
          grid-row: 2;
        }
      }
      .menu_media {
        display: block;
        grid-row: 1;
        grid-column: aside / end;
        align-self: start;
      }
    }
  }
</style>

<script>
  import { onPage } from "@/utils/page";
  import { linkMarkers } from "@/utils/link-marker";

  /* the menu's lists, as the footer's: one square glides from link to link (src/utils/link-marker.ts) */
  onPage((signal) => {
    const menu = document.getElementById("site-menu");
    if (menu) linkMarkers(menu, signal);
  });
</script>

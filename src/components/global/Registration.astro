---
import Button from "@/components/Button.astro";
import { clinic } from "@/data/clinic";
import { RISKS_PATH } from "@/consts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}
const { render = true } = Astro.props;
/* The registration banner (Figma 4001:300): the founder's AHPRA registration, the 18+ notice and the risks, a thin
   strip above the bar on the home only (Sam, Nov 26, comment 30), as the Figma draws it (1728 by 31), scrolling away
   with the page. The page under it keeps its own spacing: the strip comes first and the bar sits right under it. The
   Figma's sentence ends with « Read more » before the link of the same words: said once, as the link. Its close
   button folds it away and it stays closed for the visit (the tab's session): the short script right after it hides
   it before the first paint, so the page never jumps. */
---

{
  render && (
    <aside class="registration_wrap theme-light" aria-label="Registration and risks" data-figma-band="registration">
      <div class="registration_layout site-grid">
        <div class="registration_row">
        <p class="registration_text text-style-tight">
          {clinic.ahpra && <span class="registration_number">{clinic.ahpra}</span>} This website contains imagery suitable for audiences 18+. All non-surgical procedures carry risks.
        </p>
        <div class="registration_actions">
          <Button element="link" variant="link" href={RISKS_PATH} class="registration_link">Read more →</Button>
          <button type="button" class="registration_close" aria-label="Close this notice" data-registration-close>
            <span aria-hidden="true">×</span>
          </button>
        </div>
        </div>
      </div>
    </aside>
    <script is:inline>
      try {
        if (sessionStorage.getItem("dta-registration") === "closed") document.currentScript.previousElementSibling.hidden = true;
      } catch {}
    </script>
  )
}

<style is:global>
  @layer components {
    .registration_wrap {
      padding-block: var(--space-2);
      overflow: hidden;
    }
    /* the notice, then its link against the right edge; on a phone the link goes under it */
    .registration_row {
      grid-column: margin / end;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-2) var(--space-6);
    }
    .registration_text {
      color: var(--text-2);
    }
    .registration_number {
      color: var(--text);
    }
    .registration_actions {
      display: inline-flex;
      align-items: baseline;
      gap: var(--space-5);
    }
    .registration_close {
      padding: 0;
      border: 0;
      background: none;
      color: var(--text-2);
      font: inherit;
      line-height: 1;
      cursor: pointer;
      transition: color var(--hover-duration) var(--hover-ease);
      &:hover {
        color: var(--text);
      }
    }
    /* the strip and the bar are one block at the page's top (BaseLayout's site-top): the bar, laid over the page,
       starts under the strip */
    .site-top {
      position: relative;
      & > .registration_wrap ~ .nav_wrap {
        top: 100%;
      }
    }
    /* The menu opened over the strip (Sam, Nov 26 and 27, comment 38): everything stays where it was on screen. The
       strip is part of the menu as much as it showed (all of it at the top of the page, none once scrolled past), the
       bar right under it and the panel under the bar, so the menu's button, the logo and Book keep their places.
       --top-shift is how far the bar was below the top of the screen when the menu opened (Nav, frozen while it is
       open); --registration-height the strip's height (the script below). The strip's place in the page is kept: no
       jump under the scrim. */
    html:is([data-menu="open"], [data-menu="closing"]) .site-top:has(> .registration_wrap:not([hidden])) {
      min-height: var(--registration-height);
      & > .registration_wrap {
        position: fixed;
        inset: 0 0 auto;
        z-index: var(--z-strip);
        translate: 0 calc(var(--top-shift, 0px) - var(--registration-height));
      }
    }
    /* the bar and the panel at that distance, the strip shown or folded away (a folded strip: none) */
    html:is([data-menu="open"], [data-menu="closing"]) .site-top:has(> .registration_wrap) {
      & > .nav_wrap {
        top: var(--top-shift, 0px);
      }
      & .menu_wrap {
        top: var(--top-shift, 0px);
        max-height: calc(100svh - var(--top-shift, 0px));
      }
    }
    @media (width >= 64rem) {
      .registration_row {
        grid-column: main / end;
        flex-wrap: nowrap;
      }
    }
  }
</style>

<script>
  import { onPage } from "@/utils/page";

  /* Closed: the strip folds away (its height, --open-duration on --ease-smooth: the bar and the page rise with it, the
     one place a height moves, once) and stays closed for the tab's session. Reduced motion: it goes at once. */
  onPage((signal) => {
    const strip = document.querySelector<HTMLElement>(".registration_wrap");
    /* its height, for the menu opened over it */
    const measure = () => document.documentElement.style.setProperty("--registration-height", strip && !strip.hidden ? `${strip.offsetHeight}px` : "0px");
    measure();
    addEventListener("resize", measure, { signal });
    strip?.querySelector("[data-registration-close]")?.addEventListener(
      "click",
      () => {
        try {
          sessionStorage.setItem("dta-registration", "closed");
        } catch {}
        const css = getComputedStyle(document.documentElement);
        const v = css.getPropertyValue("--open-duration").trim();
        const duration = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : (parseFloat(v) || 0) * (v.endsWith("ms") ? 1 : 1000);
        const easing = css.getPropertyValue("--ease-smooth").trim();
        const h = strip.offsetHeight;
        const fold = strip.animate([{ height: `${h}px`, opacity: 1 }, { height: "0px", paddingBlock: "0px", opacity: 0 }], { duration, easing });
        /* the menu's button rises with the bar, frame by frame (Nav, nav:place) */
        const step = () => {
          dispatchEvent(new Event("nav:place"));
          if (fold.playState === "running") requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
        fold.finished.then(() => {
          strip.hidden = true;
          measure();
          dispatchEvent(new Event("nav:place"));
        });
      },
      { signal },
    );
  });
</script>

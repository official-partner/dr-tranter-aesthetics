---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary";

type Tag =
  | (HTMLAttributes<"button"> & {
      /** Rendered element. */
      element?: "button";
      /** Native button type. */
      type?: "button" | "submit" | "reset";
      /** Disable the button. */
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      /** Link destination. */
      href?: string;
      type?: never;
      disabled?: never;
    });

type Kind =
  | {
      /** Button type. */
      variant?: "main";
      /** Visual emphasis. */
      emphasis?: Emphasis;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "link";
      /** A link carries no weight of its own: it is already the quietest. */
      emphasis?: never;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Play` or `Pause`. */
      label?: string;
      /** Show the pause icon and pressed state. */
      pressed?: boolean;
      direction?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Next` or `Previous`. */
      label?: string;
      pressed?: never;
      /** Arrow direction. */
      direction?: "forward" | "back";
    };

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    variant?: "main" | "link" | "play" | "close" | "arrow";
    emphasis?: Emphasis;
    label?: string;
    pressed?: boolean;
    direction?: "forward" | "back";
    element?: "button" | "link";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  variant = "main",
  emphasis = "primary",
  label,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const marks = { play, close, arrow };
/* main and link are written, the rest are marks with a label. */
const isWritten = variant === "main" || variant === "link";
const written = isWritten ? await slotContent(Astro.slots) : "";
/* a closing arrow gets a box of its own: on hover it leaves to the right and comes back from the left */
const content = written.replace(/\s*→\s*$/, ' <span class="button_arrow" aria-hidden="true"><span class="button_arrow-in">→</span></span>');

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
};
---

{
  render && (isWritten ? content : true) && (
    <Tag
      class:list={[
        "button_wrap",
        emphasis !== "primary" && emphasis,
        variant !== "main" && variant,
        variant === "arrow" && direction === "back" && "back",
        className,
      ]}
      aria-label={isWritten ? undefined : (label ?? named[variant])}
      aria-pressed={variant === "play" ? pressed : undefined}
      {...tagAttrs}
      {...rest}
    >
      {isWritten && (
        <span class="button_text text-style-action">
          <Fragment set:html={content} />
        </span>
      )}
      {variant === "play" && (
        <Fragment>
          <Icon class="button_mark button_play" src={play} variant="small" />
          <Icon class="button_mark button_pause" src={pause} variant="small" />
        </Fragment>
      )}
      {variant === "close" && (
        <Icon class="button_mark" src={marks.close} variant="small" />
      )}
      {variant === "arrow" && (
        <Icon class="button_mark" src={marks.arrow} variant="small" />
      )}
    </Tag>
  )
}

<style is:global>
  @layer components {
    .button_arrow {
      display: inline-block;
      overflow: hidden;
      vertical-align: top;
    }
    .button_arrow-in {
      display: inline-block;
    }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .button_wrap:hover .button_arrow-in {
        animation: button-arrow var(--arrow-duration) var(--hover-ease);
      }
    }
    @keyframes button-arrow {
      0% {
        transform: translateX(0);
      }
      45% {
        transform: translateX(110%);
      }
      45.01% {
        transform: translateX(-110%);
      }
      100% {
        transform: translateX(0);
      }
    }
    .button_wrap {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      padding: var(--pill-y) var(--pill-x);
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: var(--radius-round);
      text-decoration: none;
      text-align: center;
      white-space: nowrap;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover:not(:disabled) {
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      &.link {
        --button-background: transparent;
        --button-text: var(--link-text);
        --button-border: transparent;
        --button-background-hover: transparent;
        --button-text-hover: var(--link-text-hover);
        --button-border-hover: transparent;
        padding: 0;
        border: 0;
        border-radius: 0;
        white-space: normal;
        text-align: start;
        justify-content: flex-start;
        & > .button_text {
          text-wrap: wrap;
        }
      }
      &:is(.play, .close, .arrow) {
        gap: 0;
        padding: 0.75em;
        border-radius: var(--radius-round);
      }
      &.back .button_mark {
        rotate: 180deg;
      }
      &.play .button_pause {
        display: none;
      }
      &.play[aria-pressed="true"] {
        & .button_play {
          display: none;
        }
        & .button_pause {
          display: block;
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
  }
</style>

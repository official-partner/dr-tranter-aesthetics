---
import { inlineRich } from "@/utils/rich";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import { pic, type Pic } from "@/utils/media";

interface Fact {
  label: string;
  value: string;
  ids?: string[];
  /** The item's field that holds the value, for OP System's Contenu and Edit. */
  field?: string;
}
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The item's name (a concern, a treatment). */
  name: string;
  /** The page it belongs to, for Back and the crumb. */
  parent?: { label: string; href: string };
  /** Its ground. */
  theme?: "inherit" | "mist" | "stone";
  /** `article`: a Journal article's opening (Figma 4001:527): its title is the page's h1, its photo on the right, no
      name nor crumb nor link. */
  variant?: "item" | "article";
  /** A line under the title (an article's summary). */
  lead?: string;
  /** Carry the Figma ids of the Melasma frame (the measured page only). */
  figma?: boolean;
  /** The opening statement, a formatted text (Markdown): *words* are set in the lighter cut. */
  statement: string;
  /** Consultation facts: label and value. */
  facts: Fact[];
  /** The item's picture. */
  image?: { src: Pic; alt?: string };
}
const { render = true, name, parent = { label: "Concerns", href: "/concerns" }, theme = "inherit", variant = "item", lead, figma = false, statement, facts, image } = Astro.props;
const f = (id: string) => (figma ? id : undefined);
---

{
  render && (
    <section class:list={["item-head_wrap section-padding", theme !== "inherit" && `theme-${theme}`, variant === "article" && "is-article"]} data-figma-band={f("top")} data-band-top={f("0")}>
      <div class="item-head_layout site-grid">
        <a class="item-head_back text-style-action inset-optical" href={parent.href} data-figma={f("1:450")}><span class="item-head_arrow" aria-hidden="true">→</span>Back</a>
        <span class="marker item-head_marker" data-figma={f("1:358")} />
        {variant === "article" ? (
          <h1 class="item-head_statement text-style-h2" data-op-field="title">{statement}</h1>
        ) : (
          <>
            <h1 class="item-head_name lead-marker text-style-h2" data-op-field="name" data-figma={f("1:434")}>{name}</h1>
            <p class="item-head_crumb text-style-action" data-figma={f("1:453")}><a class="item-head_up" href={parent.href}>{parent.label}</a> / <span class="item-head_current">{name}</span></p>
            <p class="item-head_statement text-style-h2" data-op-field="statement" data-figma={f("1:357")} data-cut-swap set:html={inlineRich(statement)} />
          </>
        )}
        {lead && <p class="item-head_lead text-style-main" data-op-field="summary">{lead}</p>}
        {/* the frame stays, empty, while the item's photo is still to come (DESIGN.md, Global classes: media) */}
        <div class="item-head_media media ratio-5-6" data-op-field="image" data-figma={f("1:359")}>
          {image && <Img {...pic(image.src)} alt={image.alt ?? ""} loading="eager" fetchPriority="high" variant="constrained" sizes="(width >= 48rem) 25vw, 75vw" />}
        </div>
        <dl class="item-head_facts">
          {facts.map((f) => (
            <div class="item-head_fact stack">
              <dt class="text-style-label" data-figma={f.ids?.[0]}>{f.label}</dt>
              <dd class="text-style-serif" data-op-field={f.field} data-figma={f.ids?.[1]}>{f.value}</dd>
            </div>
          ))}
        </dl>
        {variant !== "article" && <Button element="link" variant="link" href="#consultation" class="at-end item-head_action" data-figma={f("1:452")}>Book a consultation →</Button>}
      </div>
    </section>
  )
}

<style is:global>
  /* The opening statement swaps its two cuts (Sam, Nov 25, comment 14: « ce qui est en sans va devenir en mix, ce qui est
     en mix va devenir en sans médium… un switch smooth, loop infinie, chaque 5 s »; on the page's opening only). Two
     registered numbers carry the cut, so the font's axes glide between them. */
  @property --_swap-axis {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --_swap-weight {
    syntax: "<number>";
    inherits: true;
    initial-value: 550;
  }
  @layer components {
    [data-cut-swap] {
      --_swap-axis: var(--h2-font-axis);
      --_swap-weight: var(--h2-font-weight);
      & em {
        --_swap-axis: 50;
        --_swap-weight: 420;
      }
      &.is-swapped {
        --_swap-axis: 50;
        --_swap-weight: 420;
        & em {
          --_swap-axis: var(--h2-font-axis);
          --_swap-weight: var(--h2-font-weight);
        }
      }
      &,
      & em {
        font-weight: var(--_swap-weight);
        font-variation-settings: "SERF" var(--_swap-axis), "wght" var(--_swap-weight);
        transition:
          --_swap-axis var(--swap-duration) var(--cut-ease),
          --_swap-weight var(--swap-duration) var(--cut-ease);
      }
    }
    .item-head_wrap {
      display: flex;
      flex-direction: column;
      min-height: var(--band-concern);
    }
    .item-head_layout {
      flex: 1;
      row-gap: var(--space-7);
      align-items: start;
    }
    /* Back comes to the text's colour on hover and on focus (Sam, comment 15, Nov 24: « hover sur le back, devient
       noir »); « Concerns » in the crumb leads to the Concerns page and answers the other way, from the text's colour
       to the quieter one (comment 16: « concern cliquable »). */
    .item-head_back {
      grid-column: margin / end;
      display: inline-flex;
      gap: var(--space-3);
      color: var(--text-2);
      &:focus-visible {
        color: var(--text);
      }
    }
    .item-head_up {
      color: inherit;
      text-decoration: none;
      &:focus-visible {
        color: var(--text-2);
      }
    }
    .item-head_back,
    .item-head_up {
      transition: color var(--hover-duration) var(--hover-ease);
    }
    @media (hover: hover) {
      .item-head_back:hover {
        color: var(--text);
      }
      .item-head_up:hover {
        color: var(--text-2);
      }
    }
    .item-head_arrow {
      display: inline-block;
      rotate: 180deg;
    }
    .item-head_marker {
      display: none;
    }
    .item-head_name,
    .item-head_crumb,
    .item-head_statement,
    .item-head_media,
    .item-head_facts {
      grid-column: margin / end;
    }
    .item-head_current {
      color: var(--text-2);
    }
    .item-head_statement {
      max-width: 24ch;
      /* on a computer it takes its six columns (Sam, comment 9, Nov 24: « prendre 1 colonne de plus pour ce texte »:
         the measure of 24 characters held it to about five) */
      @media (width >= 64rem) {
        max-width: none;
      }
    }
    .item-head_facts {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-5) var(--space-8);
    }
    @media (width >= 48rem) {
      .item-head_layout {
        row-gap: 0;
        grid-template-rows: auto auto 1fr;
      }
      .item-head_back,
      .item-head_marker,
      .item-head_name,
      .item-head_crumb {
        grid-row: 1;
      }
      .item-head_back {
        grid-column: margin / span 2;
      }
      .item-head_marker {
        display: block;
        margin-top: calc((max(var(--text-action-floor), var(--text-action)) * 0.721 - var(--marker)) / 2);
      }
      .item-head_name {
        grid-column: main / span 3;
      }
      .item-head_crumb {
        grid-column: half / span 3;
        align-self: end;
      }
      .item-head_statement {
        grid-row: 2;
        grid-column: main / span 6;
        margin-top: calc(131.4 * var(--u));
      }
      .item-head_media {
        grid-row: 2 / span 2;
        grid-column: margin / span 2;
        align-self: end;
      }
      .item-head_facts,
      .item-head_action {
        grid-row: 3;
        align-self: end;
      }
      .item-head_facts {
        grid-column: main / span 5;
        display: grid;
        grid-template-columns: calc(206 * var(--u)) auto;
        gap: 0;
        /* three facts or more (a treatment: duration, downtime, sessions): each on its own column of the same step,
           the last as wide as its words */
        @media (width >= 64rem) {
          &:has(> :nth-child(3)) {
            grid-template-columns: repeat(2, calc(206 * var(--u))) auto;
          }
          &:has(> :nth-child(4)) {
            grid-template-columns: repeat(3, calc(206 * var(--u))) auto;
          }
        }
      }
    }
    @media (48rem <= width < 64rem) {
      .item-head_back {
        grid-column: margin;
      }
      .item-head_name {
        grid-column: main / aside;
      }
      /* clear of the menu's button, which stays at the top right on a tablet */
      .item-head_crumb {
        grid-column: aside / end;
        justify-self: end;
        text-align: end;
        padding-inline-end: calc(var(--burger) + var(--space-5));
      }
      .item-head_statement {
        grid-column: main / end;
        margin-top: var(--space-9);
      }
      .item-head_media {
        margin-top: var(--space-9);
      }
      .item-head_facts {
        grid-column: main / aside;
        grid-template-columns: repeat(2, minmax(0, max-content));
        margin-top: var(--space-7);
        gap: var(--space-5) var(--space-8);
      }
    }
    @media (width < 48rem) {
      .item-head_media {
        grid-column: margin / span 3;
      }
    }
    @media (width < 48rem) {
      .item-head_name {
        --_lead-marker: inline-block;
      }
    }
    /* an article's opening (Figma 4001:527): its title at the top, its summary under it, its photo on the right */
    .item-head_lead {
      grid-column: margin / end;
      max-width: 44ch;
    }
    @media (width >= 48rem) {
      .item-head_wrap.is-article {
        & .item-head_statement {
          grid-row: 1;
          margin-top: 0;
        }
        & .item-head_lead {
          grid-row: 2;
          grid-column: main / span 4;
          margin-top: var(--space-7);
        }
        /* under the menu's button, which stays at the top right */
        & .item-head_media {
          grid-row: 1 / span 3;
          grid-column: aside / end;
          align-self: start;
          margin-top: calc(var(--burger) + var(--space-5));
        }
      }
    }
    @media (width >= 64rem) {
      .item-head_wrap.is-article .item-head_statement {
        grid-column: main / span 5;
      }
    }
    @media (48rem <= width < 64rem) {
      .item-head_wrap.is-article :is(.item-head_statement, .item-head_lead) {
        grid-column: main / aside;
      }
    }
  }
</style>

<script>
  import { onPage } from "@/utils/page";

  /* The statement's cuts swap every --swap-every (5 s), only while it is on screen and the tab is shown; never under
     reduced motion (the statement stays as written). Its job: hold the eye on the page's opening words. */
  onPage((signal) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const root = document.documentElement;
    const every = (() => {
      const v = getComputedStyle(root).getPropertyValue("--swap-every").trim();
      return (parseFloat(v) || 5) * (v.endsWith("ms") ? 1 : 1000);
    })();
    document.querySelectorAll<HTMLElement>("[data-cut-swap]").forEach((el) => {
      let seen = false;
      const watch = new IntersectionObserver(([e]) => (seen = e.isIntersecting));
      watch.observe(el);
      const timer = window.setInterval(() => {
        if (seen && !document.hidden) el.classList.toggle("is-swapped");
      }, every);
      signal.addEventListener("abort", () => { window.clearInterval(timer); watch.disconnect(); });
    });
  });
</script>


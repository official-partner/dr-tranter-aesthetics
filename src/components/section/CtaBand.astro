---
import Button from "@/components/Button.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Title; emphasis with <em>, a line break with <br />. */
  title?: string;
  /** Figma ids for the build review: band top, label, marker, title, pill. */
  figma?: { top: string; label: string; marker: string; title: string; pill: string };
}
const {
  render = true,
  title = "Every new patient begins with<br />a <em>consultation</em>.",
  figma = { top: "6680", label: "1:161", marker: "1:162", title: "1:160", pill: "1:158" },
} = Astro.props;
---

{
  render && (
    <section class="cta-band_wrap section-padding theme-stone" id="consultation" data-figma-band="cta" data-band-top={figma.top}>
      <div class="cta-band_layout site-grid">
        <p class="cta-band_label lead-marker text-style-label inset-optical" data-figma={figma.label}>Where to start?</p>
        <span class="marker cta-band_marker" data-figma={figma.marker} />
        <h2 class="cta-band_title text-style-h2" data-figma={figma.title} set:html={title} />
        <div class="at-end cta-band_action">
          <Button element="link" href="#consultation" emphasis="secondary" data-figma={figma.pill}>Book a consultation</Button>
        </div>
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    /* the closing invitation ends wide on purpose, the same wide bottom as every section that breathes (Sam, Nov 10) */
    .cta-band_wrap {
      padding-bottom: var(--section-padding-wide);
    }
    .cta-band_layout {
      align-items: start;
      row-gap: var(--space-5);
    }
    .cta-band_label,
    .cta-band_title {
      grid-column: margin / end;
    }
    .cta-band_marker {
      display: none;
    }
    .cta-band_action {
      grid-column: margin / end;
      justify-self: start;
    }
    @media (width >= 64rem) {
      .cta-band_label,
      .cta-band_marker,
      .cta-band_title,
      .cta-band_action {
        grid-row: 1;
      }
      .cta-band_label {
        grid-column: margin / inset;
      }
      .cta-band_marker {
        display: block;
        margin-top: calc((max(var(--text-label-floor), var(--text-label)) * 0.721 - var(--marker)) / 2);
      }
      .cta-band_title {
        grid-column: main / span 5;
      }
      .cta-band_action {
        grid-column: aside / end;
        justify-self: end;
      }
    }
    @media (48rem <= width < 64rem) {
      .cta-band_label,
      .cta-band_title {
        grid-row: 1;
      }
      .cta-band_label {
        grid-column: margin / main;
      }
      .cta-band_title {
        grid-column: main / end;
      }
      .cta-band_action {
        grid-column: main / end;
      }
    }
    @media (width < 64rem) {
      .cta-band_label {
        --_lead-marker: inline-block;
      }
    }
  }
</style>

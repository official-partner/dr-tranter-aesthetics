---
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import { listed, ruleMarks } from "@/utils/lists";
import { pic } from "@/utils/media";

/* The home's journal (Figma « Starter (Copy) » 4001:2, Nov 25): four articles set apart across the grid, each its own
   size, the last with its title above its photo. The articles the list « journal-home » shows (its rule in
   src/data/lists.json: the first four, which OP System's List options changes). A fifth would follow the fourth. */
const shapes = ["is-a ratio-16-10", "is-b ratio-7-10", "is-c ratio-5-6", "is-d ratio-145"];
const posts = (await listed<"articles">("journal-home")).map(({ id, data }, i) => ({
  id,
  title: data.title,
  image: data.image,
  alt: data.imageAlt ?? "",
  shape: shapes[i] ?? shapes[3],
}));
---

<section class="journal-home_wrap section-padding">
  <div class="journal-home_layout site-grid">
    <h2 class="journal-home_title text-style-h2">Our journal: notes on <em>skin</em>, <em>structure</em> and <em>care</em></h2>
    <ul class="journal-home_list" {...ruleMarks("journal-home")}>
      {posts.map((p) => {
        const [slot, ratio] = p.shape.split(" ");
        return (
          <li class:list={["journal-home_card stacked-card linked-card", slot]} data-op-item={p.id}>
            <div class:list={["media", ratio]} data-op-field="image">
              {p.image && <Img {...pic(p.image)} alt={p.alt} variant="constrained" sizes="(width >= 64rem) 40vw, (width >= 48rem) 50vw, 100vw" />}
            </div>
            <div class="journal-home_meta">
              <h3 class="journal-home_card-title text-style-h3" data-op-field="title">{p.title}</h3>
              <Button element="link" variant="link" href="/journal" data-card-link>Read →</Button>
            </div>
          </li>
        );
      })}
    </ul>
    <div class="journal-home_action"><Button element="link" variant="link" href="/journal">View all articles</Button></div>
  </div>
</section>

<style is:global>
  @layer components {
    .journal-home_title {
      grid-column: margin / end;
      max-width: 19.7ch;
    }
    /* its articles are the layout's own items: the list holds them for OP System only */
    .journal-home_layout {
      row-gap: var(--space-stack);
    }
    .journal-home_list {
      display: contents;
    }
    .journal-home_card {
      grid-column: margin / end;
    }
    /* a title, its « Read → » set against the right edge, on the photo's width */
    .journal-home_meta {
      align-self: stretch;
      display: flex;
      justify-content: space-between;
      align-items: start;
      column-gap: var(--space-5);
      margin-top: var(--space-media);
      & > .button_wrap {
        flex: none;
      }
    }
    .journal-home_card-title {
      max-width: 18ch;
    }
    /* the last: its title above its photo, its « Read → » at the foot of the block, on the right (Sam, comment 9) */
    .journal-home_card.is-d {
      & .journal-home_meta {
        display: contents;
      }
      & .journal-home_card-title {
        order: -1;
        margin-bottom: var(--space-media);
      }
      & .button_wrap {
        align-self: end;
        margin-top: var(--space-media);
      }
    }
    .journal-home_action {
      grid-column: margin / end;
      justify-self: end;
      margin-top: var(--space-8);
    }

    /* tablet: two columns, the right one a beat lower */
    @media (48rem <= width < 64rem) {
      .journal-home_card {
        grid-column: margin / span 4;
        &:is(.is-a, .is-c) {
          grid-column: span 4 / end;
        }
        &.is-c {
          margin-top: var(--space-11);
        }
        &.is-d {
          grid-column: main / end;
        }
      }
    }

    /* computer: the composition of the design, each article on its own columns */
    @media (width >= 64rem) {
      .journal-home_layout {
        align-items: start;
        row-gap: var(--space-11);
      }
      .journal-home_title {
        grid-row: 1;
        grid-column: margin / span 4;
      }
      .journal-home_card {
        &.is-a {
          grid-row: 1 / span 2;
          grid-column: third / end;
        }
        &.is-b {
          grid-row: 2;
          grid-column: margin / span 4;
        }
        &.is-c {
          grid-row: 2;
          grid-column: half / span 3;
          /* more room above it (Sam, comment 8: « faire plus respirer ») */
          margin-top: calc(var(--space-11) * 2 + var(--space-10));
        }
        &.is-d {
          grid-row: 3;
          grid-column: marker / span 5;
          margin-top: calc(var(--space-11) + var(--space-10));
        }
      }
      .journal-home_action {
        grid-row: 3;
        grid-column: aside / end;
        align-self: end;
        margin-top: 0;
      }
    }
  }
</style>

---
import Card from "@/components/content/Card.astro";
import type { Pic } from "@/utils/media";

interface Item {
  id: string;
  name: string;
  summary?: string;
  href?: string;
  image?: { src: Pic; alt?: string };
  /** Its filter (a category's name), when the group has filters. */
  category?: string;
  /** Hidden while no filter is chosen (it shows in a group above). */
  aside?: boolean;
  /** Figma node ids for the build review: image, name, text, link. */
  ids?: string[];
}
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The group's name (Structure, Surface, Featured treatments, Filter by). */
  label: string;
  /** Its ground. */
  theme?: "light" | "stone" | "mist";
  /** The collection the cards show, for OP System's Contenu and Edit. */
  collection: string;
  /** What one item is called in OP System (Concern, Treatment). */
  noun: string;
  /** The field the card's line comes from. */
  textField?: string;
  /** The words of a card's link. */
  link?: string;
  /** The cards, two to a row. */
  items: Item[];
  /** Filters under the name: one pill per category, after « All »; a pill shows only its cards. */
  filters?: { all: string; values: string[]; ids?: string[] };
  /** The list's name for OP System, when a page has two groups of the same collection. */
  list?: string;
  /** Figma ids for the build review: band name, band top, label, marker. */
  figma?: { band: string; top: string; label: string; marker: string };
}
const { render = true, label, theme = "light", collection, noun, textField = "summary", link = "View →", items, filters, list, figma } = Astro.props;
const slug = (v: string) => v.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

{/* A group of cards (the Concerns page, the Treatments page): its name at the margin with the square, its cards two to a
    row from the main rail (Figma 59:602, 59:983, Nov 20). With filters, a pill per category under the name. */}
{
  render && items.length > 0 && (
    <section class:list={["card-group_wrap section-padding", `theme-${theme}`]} data-figma-band={figma?.band} data-band-top={figma?.top}>
      <div class="card-group_layout site-grid">
        <div class="card-group_head">
          <p class="card-group_label lead-marker text-style-label inset-optical" data-figma={figma?.label}><span class="card-group_word">{label}</span></p>
          {filters && (
            <div class="card-group_filters" role="group" aria-label={label} data-card-filters>
              {[filters.all, ...filters.values].map((v, i) => (
                <button type="button" class="card-group_filter text-style-action" aria-pressed={i === 0 ? "true" : "false"} data-filter={i === 0 ? "" : slug(v)} data-figma={filters.ids?.[i]}>{v}</button>
              ))}
            </div>
          )}
        </div>
        <span class="marker card-group_marker" data-figma={figma?.marker} />
        <ul class="card-group_list" data-op-list={list ?? collection} data-op-source={`astro:${collection}`} data-op-noun={noun}>
          {items.map((c) => (
            <li class="card-group_item" data-op-item={c.id} data-category={c.category && slug(c.category)} data-aside={c.aside ? "" : undefined} hidden={c.aside && filters ? true : undefined}>
              <Card title={c.name} text={c.summary} href={c.href} link={link} image={c.image} item={{ collection, id: c.id, textField }} ids={c.ids} />
            </li>
          ))}
        </ul>
        {filters && <p class="sr-only" aria-live="polite" data-card-count />}
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    /* a group ends wide, on purpose, as every section that breathes (Sam, Nov 10, 13:10) */
    .card-group_wrap {
      padding-bottom: var(--section-padding-wide);
    }
    .card-group_layout {
      row-gap: var(--space-7);
    }
    .card-group_head,
    .card-group_list {
      grid-column: margin / end;
    }
    /* the name's word rolls in its place when the next group takes over (the script below) */
    .card-group_label {
      overflow: clip;
      padding-block: 0.2em;
      margin-block: -0.2em;
      transition: opacity var(--open-duration) var(--open-ease);
    }
    .card-group_word {
      display: inline-block;
    }
    .card-group_filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
      margin-top: var(--space-4);
      @media (width >= 64rem) {
        flex-direction: column;
        align-items: flex-start;
      }
    }
    .card-group_filter {
      padding: var(--tag-y) var(--tag-x);
      border: var(--border-width) solid var(--button-border);
      border-radius: var(--radius-round);
      color: var(--button-text);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-color: var(--pill-border-solid);
        }
      }
      /* the chosen filter: filled with the text's colour */
      &[aria-pressed="true"] {
        background-color: var(--text);
        border-color: var(--text);
        color: var(--background);
      }
    }
    .card-group_marker {
      display: none;
    }
    /* A group's name (with its filters) and its square stay in view while the group scrolls by (Sam's comment 1,
       Nov 20: « le texte et le petit carré de gauche sticky au scroll »), level with the menu's button, from a tablet
       up. A global class (pinned) until Nov 24, when the closing invitation stopped using it (comment 14). */
    @media (width >= 48rem) {
      .card-group_head,
      .card-group_marker {
        position: sticky;
        top: var(--pinned-top);
        align-self: start;
      }
      .card-group_marker {
        top: calc(var(--pinned-top) + (max(var(--text-label-floor), var(--text-label)) * 0.721 - var(--marker)) / 2);
      }
    }
    .card-group_list {
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-stack);
      /* two cards to a row: every row as tall as the tallest, so a card with no link yet keeps the rhythm */
      @media (width >= 48rem) {
        grid-auto-rows: 1fr;
      }
    }
    /* phone: the cards on three columns of four, left then right, as every row of cards. Left and right are counted
       among the cards shown, so a filter never leaves a hole (Sam, comment 13, Nov 24: « le reorder des items ») */
    .card-group_item {
      grid-column: margin / span 3;
      &:nth-child(even of :not([hidden])) {
        grid-column: span 3 / end;
      }
    }
    @media (width < 48rem) {
      .card-group_layout {
        grid-auto-flow: row dense;
      }
      .card-group_head {
        grid-column: span 3 / end;
      }
      .card-group_marker {
        display: block;
        grid-column: margin;
        margin-top: calc((max(var(--text-label-floor), var(--text-label)) * 0.721 - var(--marker)) / 2);
      }
    }
    @media (width >= 48rem) {
      .card-group_layout {
        row-gap: 0;
      }
      .card-group_head,
      .card-group_marker,
      .card-group_list {
        grid-row: 1;
        align-self: start;
      }
      .card-group_list {
        grid-column: main / end;
      }
    }
    /* tablet: the name on the first three columns, the cards on two columns each (main, aside) */
    @media (48rem <= width < 64rem) {
      .card-group_head {
        grid-column: margin / main;
      }
      .card-group_label {
        --_lead-marker: inline-block;
      }
      .card-group_item {
        grid-column: main / span 2;
        &:nth-child(even of :not([hidden])) {
          grid-column: aside / end;
        }
      }
    }
    @media (width >= 64rem) {
      .card-group_head {
        grid-column: margin / marker;
      }
      .card-group_marker {
        display: block;
        margin-top: calc((max(var(--text-label-floor), var(--text-label)) * 0.721 - var(--marker)) / 2);
      }
      .card-group_list {
        row-gap: var(--space-8);
      }
      .card-group_item {
        grid-column: main / span 3;
        &:nth-child(even of :not([hidden])) {
          grid-column: third / span 3;
        }
      }
    }
  }
</style>

<script>
  import { onPage } from "@/utils/page";
  import { pageLenis } from "@/utils/smooth-scroll";

  onPage((signal) => {
    const root = document.documentElement;
    const calm = matchMedia("(prefers-reduced-motion: reduce)");
    const ms = (name: string) => {
      const v = getComputedStyle(root).getPropertyValue(name).trim();
      return (parseFloat(v) || 0) * (v.endsWith("ms") ? 1 : 1000);
    };

    /* A group's filters (Sam, Nov 21, idea 6; Nov 24, comment 13: « les filters sont buggy, ça marche pas bien le
       reorder des items. aussi, on doit scroll up au top de la section quand on clique un filtre… seamless »). A pill
       shows only its category's cards; « All » shows the group as it came (the cards featured above stay there). One
       thing after the other: the page goes back to the group's top when the group starts above the screen; the cards
       that go fade out where they are (--filter-out-duration); then the cards that stay travel to their new places
       while those that come fade in at theirs (--filter-duration). Places are measured against the list, so the scroll
       never disturbs them, and a click in the middle of a change starts from where the cards are. Before (Nov 21) the
       browser's view transition froze the whole page for the change and crossfaded it, which broke when the page
       scrolled. The count is said to screen readers. Reduced motion: at once. */
    document.querySelectorAll<HTMLElement>("[data-card-filters]").forEach((pills) => {
      const group = pills.closest<HTMLElement>(".card-group_wrap");
      const list = group?.querySelector<HTMLElement>(".card-group_list");
      if (!group || !list) return;
      const items = [...list.querySelectorAll<HTMLElement>(":scope > .card-group_item")];
      const count = group.querySelector<HTMLElement>("[data-card-count]");
      let running: Animation[] = [];
      let turn = 0;
      const wants = (li: HTMLElement, value: string) => (value ? li.dataset.category === value : !li.hasAttribute("data-aside"));
      /* a card's place against the list, and its opacity, as they are on screen now (in the middle of a change too) */
      const now = (li: HTMLElement) => {
        const l = list.getBoundingClientRect();
        const r = li.getBoundingClientRect();
        return { x: r.left - l.left, y: r.top - l.top, o: parseFloat(getComputedStyle(li).opacity) };
      };
      const run = (li: HTMLElement, frames: Keyframe[], options: KeyframeAnimationOptions) => running.push(li.animate(frames, options));

      pills.addEventListener("click", (e) => {
        const pill = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-filter]");
        if (!pill || pill.getAttribute("aria-pressed") === "true") return;
        const value = pill.dataset.filter ?? "";
        const mine = ++turn;
        const quick = calm.matches;
        pills.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === pill)));
        /* back to the group's top when it starts above the screen */
        const top = group.getBoundingClientRect().top;
        if (top < -1) {
          const y = Math.round(top + window.scrollY);
          const lenis = pageLenis();
          if (lenis && !quick) lenis.scrollTo(y, { duration: ms("--filter-duration") / 1000 });
          else window.scrollTo({ top: y, behavior: quick ? "auto" : "smooth" });
        }
        const apply = () => {
          let shown = 0;
          items.forEach((li) => {
            li.hidden = !wants(li, value);
            if (!li.hidden) shown++;
          });
          if (count) count.textContent = `${shown} shown`;
        };
        if (quick) {
          running.forEach((a) => a.cancel());
          running = [];
          return apply();
        }
        const time = ms("--filter-duration");
        const out = ms("--filter-out-duration");
        const easing = getComputedStyle(root).getPropertyValue("--ease-smooth").trim() || "ease-out";
        const going = items.filter((li) => !li.hidden && !wants(li, value));
        going.forEach((li) => run(li, [{ opacity: now(li).o }, { opacity: 0 }], { duration: out, easing, fill: "forwards" }));
        window.setTimeout(() => {
          if (mine !== turn) return;
          const before = new Map(items.filter((li) => !li.hidden).map((li) => [li, now(li)]));
          running.forEach((a) => a.cancel());
          running = [];
          apply();
          items.filter((li) => !li.hidden).forEach((li) => {
            const was = before.get(li);
            if (!was) return run(li, [{ opacity: 0 }, { opacity: 1 }], { duration: time, easing, delay: time * 0.25, fill: "backwards" });
            const at = now(li);
            const dx = was.x - at.x;
            const dy = was.y - at.y;
            if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5 && was.o > 0.99) return;
            run(li, [{ translate: `${dx}px ${dy}px`, opacity: was.o }, { translate: "0 0", opacity: 1 }], { duration: time, easing });
          });
        }, going.length ? out : 0);
      }, { signal });
    });

    /* One name, one square down the page (Sam, Nov 21, idea 5 and his note: « ça reste le même élément », « un switch
       de texte entre structure et surface »). Each group has its own pinned name and square (`.card-group_head`, `.card-group_marker`: sticky).
       Between two groups that follow each other, the first's would be pushed up and out as the second's came up from
       below: two of each for a moment. Here the first group's stay on the line until the next group's ground reaches
       them, then the next group's take their place there, already on the line: the square never moves, and the
       name's word rolls to the new one (up going down the page, down coming back). From a tablet up, where they
       holds; under reduced motion the groups keep their own, as written. */
    const groups = [...document.querySelectorAll<HTMLElement>(".card-group_wrap")];
    /* two groups follow each other when the second starts where the first ends */
    const pairs = groups.slice(1).map((b, i) => [groups[i], b]);
    const touch = (a: HTMLElement, b: HTMLElement) => Math.abs(a.getBoundingClientRect().bottom - b.getBoundingClientRect().top) < 2;
    if (!pairs.length) return;
    const wide = matchMedia("(width >= 48rem)");
    const moved = new Map<HTMLElement, number>();
    const move = (el: HTMLElement | null, y: number) => {
      if (!el) return;
      if ((moved.get(el) ?? 0) === y) return;
      moved.set(el, y);
      el.style.translate = y ? `0 ${y}px` : "";
    };
    /* where an element sits without what this script moved it by */
    const top = (el: HTMLElement) => el.getBoundingClientRect().top - (moved.get(el) ?? 0);
    const show = (el: HTMLElement | null, on: boolean, soft = true) => {
      if (!el) return;
      if (soft) el.style.opacity = on ? "" : "0";
      else el.style.visibility = on ? "" : "hidden";
    };
    const of = (g: HTMLElement) => ({
      head: g.querySelector<HTMLElement>(".card-group_head")!,
      label: g.querySelector<HTMLElement>(".card-group_label")!,
      word: g.querySelector<HTMLElement>(".card-group_word")!,
      marker: g.querySelector<HTMLElement>(".card-group_marker"),
    });
    const state = new Map<HTMLElement, boolean>();
    const roll = (out: HTMLElement, into: HTMLElement, up: boolean) => {
      const time = ms("--roll-duration");
      const easing = getComputedStyle(root).getPropertyValue("--ease-smooth").trim() || "ease-out";
      out.animate([{ translate: "0 0" }, { translate: `0 ${up ? -140 : 140}%` }], { duration: time * 0.6, easing });
      into.animate([{ translate: `0 ${up ? 140 : -140}%` }, { translate: "0 0" }], { duration: time, easing });
    };
    const clear = () => {
      for (const g of groups) {
        const p = of(g);
        for (const el of [p.head, p.label, p.marker]) { move(el, 0); show(el, true); show(el, true, false); }
      }
      state.clear();
    };
    const follow = () => {
      if (!wide.matches || calm.matches) return clear();
      for (const [a, b] of pairs) {
        const A = of(a), B = of(b);
        const line = parseFloat(getComputedStyle(A.head).top) || 0;
        /* the second group's name is placed by its head, which this script never moves */
        const aTop = top(A.head), bTop = top(B.head);
        /* the first group's name is on the line (or would be pushed above it), the second's has not reached it */
        const mine = touch(a, b) && aTop <= line + 0.5 && bTop > line + 0.5;
        if (!mine) {
          move(A.head, 0); move(A.marker, 0); move(B.label, 0); move(B.marker, 0);
          for (const el of [A.head, B.label]) show(el, true);
          for (const el of [A.marker, B.marker]) show(el, true, false);
          state.delete(a);
          continue;
        }
        /* the next group's ground has reached the name: it takes over */
        const passed = b.getBoundingClientRect().top <= line + A.label.offsetHeight / 2;
        move(A.head, Math.max(0, line - aTop));
        move(B.label, line - bTop);
        if (A.marker && B.marker && A.marker.offsetParent && B.marker.offsetParent) {
          const mLine = parseFloat(getComputedStyle(A.marker).top) || 0;
          move(A.marker, Math.max(0, mLine - top(A.marker)));
          move(B.marker, mLine - top(B.marker));
          show(A.marker, !passed, false);
          show(B.marker, passed, false);
        }
        show(A.head, !passed);
        show(B.label, passed);
        const was = state.get(a);
        if (was !== undefined && was !== passed) passed ? roll(A.word, B.word, true) : roll(B.word, A.word, false);
        state.set(a, passed);
      }
    };
    let frame = 0;
    const ask = () => { if (!frame) frame = requestAnimationFrame(() => { frame = 0; follow(); }); };
    follow();
    window.addEventListener("scroll", ask, { signal, passive: true });
    window.addEventListener("resize", ask, { signal });
    signal.addEventListener("abort", () => { cancelAnimationFrame(frame); clear(); });
  });
</script>

---
import Card from "@/components/content/Card.astro";
import type { Pic } from "@/utils/media";

interface Item {
  id: string;
  name: string;
  summary?: string;
  href?: string;
  image?: { src: Pic; alt?: string };
  /** Figma node ids for the build review: image, name, text, link. */
  ids?: string[];
}
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The group's name (Structure, Surface). */
  label: string;
  /** Its ground. */
  theme?: "light" | "stone";
  /** The group's concerns, two to a row. */
  items: Item[];
  /** Figma ids for the build review: band name, band top, label, marker. */
  figma?: { band: string; top: string; label: string; marker: string };
}
const { render = true, label, theme = "light", items, figma } = Astro.props;
---

{/* A group of concerns on the Concerns page: its name at the margin with the square, its cards two to a row from the
    main rail (Figma 59:602, Nov 20). */}
{
  render && items.length > 0 && (
    <section class:list={["concern-group_wrap section-padding", `theme-${theme}`]} data-figma-band={figma?.band} data-band-top={figma?.top}>
      <div class="concern-group_layout site-grid">
        <p class="concern-group_label lead-marker text-style-label inset-optical" data-figma={figma?.label}>{label}</p>
        <span class="marker concern-group_marker" data-figma={figma?.marker} />
        <ul class="concern-group_list" data-op-list="concerns" data-op-source="astro:concerns" data-op-noun="Concern">
          {items.map((c) => (
            <li class="concern-group_item" data-op-item={c.id}>
              <Card
                title={c.name}
                text={c.summary}
                href={c.href}
                link="View concern →"
                image={c.image}
                item={{ collection: "concerns", id: c.id, textField: "summary" }}
                ids={c.ids}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    /* a group ends wide, on purpose, as every section that breathes (Sam, Nov 10, 13:10) */
    .concern-group_wrap {
      padding-bottom: var(--section-padding-wide);
    }
    .concern-group_layout {
      row-gap: var(--space-7);
    }
    .concern-group_label,
    .concern-group_list {
      grid-column: margin / end;
    }
    .concern-group_marker {
      display: none;
    }
    .concern-group_list {
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-stack);
      /* two cards to a row: every row as tall as the tallest, so a card with no link yet keeps the rhythm */
      @media (width >= 48rem) {
        grid-auto-rows: 1fr;
      }
    }
    /* phone: the cards on three columns of four, left then right, as every row of cards */
    .concern-group_item {
      grid-column: margin / span 3;
      &:nth-child(even) {
        grid-column: span 3 / end;
      }
    }
    @media (width < 48rem) {
      .concern-group_layout {
        grid-auto-flow: row dense;
      }
      .concern-group_label {
        grid-column: span 3 / end;
      }
      .concern-group_marker {
        display: block;
        grid-column: margin;
        margin-top: calc((max(var(--text-label-floor), var(--text-label)) * 0.721 - var(--marker)) / 2);
      }
    }
    @media (width >= 48rem) {
      .concern-group_layout {
        row-gap: 0;
      }
      .concern-group_label,
      .concern-group_marker,
      .concern-group_list {
        grid-row: 1;
        align-self: start;
      }
      .concern-group_list {
        grid-column: main / end;
      }
    }
    /* tablet: the name on the first three columns, the cards on two columns each (main, aside) */
    @media (48rem <= width < 64rem) {
      .concern-group_label {
        grid-column: margin / main;
        --_lead-marker: inline-block;
      }
      .concern-group_item {
        grid-column: main / span 2;
        &:nth-child(even) {
          grid-column: aside / end;
        }
      }
    }
    @media (width >= 64rem) {
      .concern-group_label {
        grid-column: margin / marker;
      }
      .concern-group_marker {
        display: block;
        margin-top: calc((max(var(--text-label-floor), var(--text-label)) * 0.721 - var(--marker)) / 2);
      }
      .concern-group_list {
        row-gap: var(--space-8);
      }
      .concern-group_item {
        grid-column: main / span 3;
        &:nth-child(even) {
          grid-column: third / span 3;
        }
      }
    }
  }
</style>

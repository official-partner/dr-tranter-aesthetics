---
import Button from "@/components/Button.astro";
import IndexList from "@/components/content/IndexList.astro";
import Img from "@/components/media/Img.astro";
import { pic, type Pic } from "@/utils/media";

interface Item {
  title: string;
  text: string;
  /** Figma node ids for the build review: title, text. */
  ids?: string[];
}
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Start on a hairline, after a band on the same ground. */
  rule?: boolean;
  /** End wide, on purpose, as every section that breathes (--section-padding-wide). */
  endWide?: boolean;
  /** Section title; emphasis with <em>. */
  title: string;
  /** The text on the main rail; paragraphs apart by an empty line. */
  text: string;
  /** A tall picture from the half rail to the edge (The Clinic's One standard of care); its link then sits under the
      text, level with the picture's foot. */
  image?: { src?: Pic; alt?: string };
  /** A short list on the aside rail, each a name and a line, unnumbered (Where we focus). */
  list?: Item[];
  /** A link against the right edge, level with the text's last line. */
  action?: { label: string; href: string };
  /** A list written in the page: its name for OP System's Modifier. */
  listName?: string;
  /** Color theme. */
  theme?: "inherit" | "stone" | "mist";
  /** Figma ids for the build review: band name, band top, title, text, action. */
  figma?: { band: string; top: string; title: string; text: string; action?: string };
}
const { render = true, rule = false, endWide = false, title, text, image, list, action, listName, theme = "inherit", figma } = Astro.props;
const paras = text.split(/\n{2,}/);
const steps = list?.map((i) => ({ title: i.title, text: i.text, ids: ["", i.ids?.[0] ?? "", i.ids?.[1] ?? ""] }));
---

{/* A title, its text on the main rail, and an unnumbered list or a link on the right (Our Approach, Nov 20): the
    « What is happening » composition of a concern, reused. */}
{
  render && (
    <section class:list={["text-section_wrap section-padding", image && "has-image", theme !== "inherit" && `theme-${theme}`, rule && "section-rule", endWide && "is-end-wide"]} data-figma-band={figma?.band} data-band-top={figma?.top}>
      <div class="text-section_layout site-grid">
        <h2 class="text-section_title text-style-h2" data-figma={figma?.title} set:html={title} />
        {paras.length > 1 ? (
          <div class="text-section_text stack" data-figma={figma?.text}>{paras.map((t) => <p class="text-style-main" set:html={t} />)}</div>
        ) : (
          <p class="text-section_text text-style-main" data-figma={figma?.text} set:html={text} />
        )}
        {image && (
          <div class="text-section_media media">{image.src && <Img {...pic(image.src)} alt={image.alt ?? ""} variant="constrained" sizes="(width >= 48rem) 45vw, 100vw" />}</div>
        )}
        {steps && <IndexList steps={steps} variant="aside" numbered={false} list={listName} class="text-section_list" />}
        {action && (
          <div class="at-end text-section_action">
            <Button element="link" variant="link" href={action.href} data-figma={figma?.action}>{action.label}</Button>
          </div>
        )}
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    .text-section_layout {
      row-gap: var(--space-7);
    }
    /* a section that breathes ends wide (Sam, Nov 25, comments 19 and 20: The Clinic's four blocks, a treatment's How
       it works) */
    .text-section_wrap.is-end-wide {
      padding-bottom: var(--section-padding-wide);
    }
    .text-section_title,
    .text-section_text {
      grid-column: margin / end;
    }
    .text-section_title {
      max-width: 15ch;
    }
    .text-section_text.stack {
      gap: var(--space-5);
    }
    .text-section_media {
      grid-column: margin / end;
    }
    /* with a picture (The Clinic): the text on three columns, the picture from the half rail to the edge, the link
       under the text at the picture's foot */
    @media (width >= 64rem) {
      .text-section_wrap.has-image {
        & .text-section_text {
          grid-column: main / span 3;
        }
        & .text-section_media {
          grid-row: 1 / span 2;
          grid-column: half / end;
        }
        & .text-section_action {
          grid-row: 2;
          grid-column: main / half;
          justify-self: start;
        }
      }
    }
    @media (width >= 48rem) {
      .text-section_layout {
        row-gap: 0;
      }
      .text-section_title,
      .text-section_text,
      .text-section_layout > .text-section_list {
        grid-row: 1;
      }
    }
    @media (width >= 64rem) {
      .text-section_title {
        grid-column: margin / span 3;
      }
      .text-section_text {
        grid-column: main / span 4;
      }
      .text-section_action {
        grid-row: 1;
        grid-column: aside / end;
        align-self: end;
      }
    }
    /* tablet: the title at the margin, the text and the list on the main rail, as a concern's « What is happening » */
    @media (48rem <= width < 64rem) {
      .text-section_title {
        grid-column: margin / main;
      }
      .text-section_text {
        grid-column: main / end;
      }
      .text-section_action {
        grid-row: 2;
        grid-column: main / end;
        justify-self: start;
        margin-top: var(--space-7);
      }
      .text-section_media {
        grid-row: 3;
        grid-column: main / end;
        margin-top: var(--space-7);
      }
    }
  }
</style>

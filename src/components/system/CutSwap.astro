---
/* The cut swap (Sam, Nov 25, comments 14, 15 and 18): an important text in the h2's style, at the opening of a page or
   in a closing band, swaps its two cuts every --swap-every: what is set in the sans becomes the lighter mix, what is in
   the mix becomes the sans, a smooth glide, again and again. Mark the element `data-cut-swap`. Its lines hold: every
   line keeps the same words before, during and after the glide (comment 15), so the paragraph never moves. */
---

<style is:global>
  /* two registered numbers carry the cut, so the font's axes glide between them */
  @property --_swap-axis {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --_swap-weight {
    syntax: "<number>";
    inherits: true;
    initial-value: 550;
  }
  @layer components {
    [data-cut-swap] {
      --_swap-axis: var(--h2-font-axis);
      --_swap-weight: var(--h2-font-weight);
      & em {
        --_swap-axis: 50;
        --_swap-weight: 420;
      }
      &.is-swapped {
        --_swap-axis: 50;
        --_swap-weight: 420;
        & em {
          --_swap-axis: var(--h2-font-axis);
          --_swap-weight: var(--h2-font-weight);
        }
      }
      &,
      & em {
        font-weight: var(--_swap-weight);
        font-variation-settings: "SERF" var(--_swap-axis), "wght" var(--_swap-weight);
        transition:
          --_swap-axis var(--swap-duration) var(--cut-ease),
          --_swap-weight var(--swap-duration) var(--cut-ease);
      }
      /* while its lines are measured, each cut shows at once */
      &.is-measuring,
      &.is-measuring em {
        transition: none;
      }
      /* its lines held: the breaks the script set, and no other */
      &.is-held {
        white-space: nowrap;
        text-wrap: nowrap;
      }
    }
  }
</style>

<script>
  import { onPage } from "@/utils/page";

  /* Its job: hold the eye on a page's opening words and on the closing invitation. Each swaps only while on screen and
     the tab is shown; never under reduced motion (the text stays as written), never while OP System edits it. Before
     the first swap, the script finds where the lines break in the wider of the two cuts and holds those breaks (a
     <br data-cut-br>, the text kept nowrap), so the narrower cut fits the same lines; on a new width it lets the text
     go, measures again and holds again. */
  onPage((signal) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const root = document.documentElement;
    const every = (() => {
      const v = getComputedStyle(root).getPropertyValue("--swap-every").trim();
      return (parseFloat(v) || 5) * (v.endsWith("ms") ? 1 : 1000);
    })();

    /* the text as written: no break of ours, its words whole again */
    const release = (el: HTMLElement) => {
      el.querySelectorAll("br[data-cut-br]").forEach((b) => b.remove());
      el.normalize();
      el.classList.remove("is-held");
    };
    /* where each line starts: the text node and offset of its first word */
    const lineStarts = (el: HTMLElement) => {
      const starts: [Text, number][] = [];
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const range = document.createRange();
      let last: number | null = null;
      for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
        const text = node.data;
        for (let i = 0; i < text.length; i++) {
          /* a line can start after a space, a hyphen or a slash (« in-clinic » breaks after « in- ») */
          if (/\s/.test(text[i]) || (i > 0 && !/[\s\-\u2010-\u2013/]/.test(text[i - 1]))) continue;
          range.setStart(node, i);
          range.setEnd(node, i + 1);
          const rect = range.getClientRects()[0];
          if (!rect) continue;
          if (last !== null && rect.top > last + rect.height / 2) starts.push([node, i]);
          last = rect.top;
        }
      }
      return starts;
    };
    /* nothing but spaces between a written <br> and this point */
    const afterBreak = (node: Text, offset: number) => {
      if (node.data.slice(0, offset).trim()) return false;
      let at: Node | null = node;
      while (at) {
        let prev: Node | null = at.previousSibling;
        while (prev && prev.nodeType === Node.TEXT_NODE && !prev.textContent?.trim()) prev = prev.previousSibling;
        if (prev) return prev.nodeName === "BR";
        at = at.parentNode;
        if (at instanceof HTMLElement && at.hasAttribute("data-cut-swap")) return false;
      }
      return false;
    };
    /* the cut in which the text is wider, measured on one line */
    const widerSwapped = (el: HTMLElement) => {
      el.classList.add("is-measuring", "is-held");
      const was = el.classList.contains("is-swapped");
      el.classList.remove("is-swapped");
      const plain = el.scrollWidth;
      el.classList.add("is-swapped");
      const swapped = el.scrollWidth;
      el.classList.toggle("is-swapped", was);
      el.classList.remove("is-held");
      return swapped > plain;
    };
    const hold = (el: HTMLElement) => {
      release(el);
      if (!el.getClientRects().length || el.isContentEditable) return;
      const was = el.classList.contains("is-swapped");
      el.classList.add("is-measuring");
      el.classList.toggle("is-swapped", widerSwapped(el));
      const starts = lineStarts(el);
      /* from the last, so each split leaves the earlier offsets where they were; a line the text already starts
         with its own <br> keeps that one only */
      for (const [node, offset] of starts.reverse()) {
        if (afterBreak(node, offset)) continue;
        const after = node.splitText(offset);
        const br = document.createElement("br");
        br.setAttribute("data-cut-br", "");
        after.before(br);
      }
      el.classList.add("is-held");
      el.classList.toggle("is-swapped", was);
      void el.offsetWidth;
      el.classList.remove("is-measuring");
    };

    const els = [...document.querySelectorAll<HTMLElement>("[data-cut-swap]")];
    if (!els.length) return;
    const holdAll = () => els.forEach(hold);
    document.fonts?.ready.then(() => !signal.aborted && holdAll());
    holdAll();
    let width = window.innerWidth;
    let wait = 0;
    window.addEventListener(
      "resize",
      () => {
        if (window.innerWidth === width) return;
        width = window.innerWidth;
        window.clearTimeout(wait);
        wait = window.setTimeout(holdAll, 150);
      },
      { signal },
    );

    els.forEach((el) => {
      let seen = false;
      const watch = new IntersectionObserver(([e]) => (seen = e.isIntersecting));
      watch.observe(el);
      /* OP System's Edit makes the text editable: it gets the text as written, and the swap waits */
      const editing = new MutationObserver(() => {
        if (el.isContentEditable) {
          release(el);
          el.classList.remove("is-swapped");
        } else hold(el);
      });
      editing.observe(el, { attributes: true, attributeFilter: ["contenteditable"] });
      const timer = window.setInterval(() => {
        if (seen && !document.hidden && !el.isContentEditable) el.classList.toggle("is-swapped");
      }, every);
      signal.addEventListener("abort", () => {
        window.clearInterval(timer);
        window.clearTimeout(wait);
        watch.disconnect();
        editing.disconnect();
        release(el);
      });
    });
  });
</script>

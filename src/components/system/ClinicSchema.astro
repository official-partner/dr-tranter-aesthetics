---
import { SITE_URL } from "@/consts.ts";
import { clinic } from "@/data/site.ts";

/* The clinic's data for search engines: the address, phone and hours the footer shows, from the same file. */
const data = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: clinic.name,
  url: SITE_URL,
  telephone: `+${clinic.phoneHref.replace(/^\+/, "")}`,
  address: {
    "@type": "PostalAddress",
    streetAddress: clinic.street,
    addressLocality: clinic.locality,
    addressRegion: clinic.region,
    postalCode: clinic.postcode,
    addressCountry: clinic.country,
  },
  openingHoursSpecification: clinic.hours.map((slot) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: slot.schema.map(
      (d) =>
        ({
          Mo: "Monday",
          Tu: "Tuesday",
          We: "Wednesday",
          Th: "Thursday",
          Fr: "Friday",
          Sa: "Saturday",
        })[d],
    ),
    opens: slot.opens,
    closes: slot.closes,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />

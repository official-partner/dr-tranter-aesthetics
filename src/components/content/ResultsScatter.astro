---
import Img from "@/components/media/Img.astro";
import { getItems, img } from "@/utils/content";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const results = await getItems("results");
---

{
  render && results.length > 0 && (
    <ol
      class="results_wrap swipe-row"
      data-op-list="results"
      data-op-source="astro:results"
    >
      {results.map(({ id, data }) => (
        <li
          class="results_case"
          data-op-item={id}
          data-results-case
          data-view="after"
        >
          <div class="results_frame media-frame">
            <div class="results_view results_before">
              {data.beforePhoto ? (
                <Img
                  {...img(data.beforePhoto)}
                  alt={`${data.treatment}: before`}
                  variant="constrained"
                  sizes="(min-width: 64rem) 30vw, 78vw"
                />
              ) : (
                <span class="media-placeholder">Before photo to supply</span>
              )}
            </div>
            <div class="results_view results_after">
              {data.afterPhoto ? (
                <Img
                  {...img(data.afterPhoto)}
                  alt={`${data.treatment}: after`}
                  variant="constrained"
                  sizes="(min-width: 64rem) 30vw, 78vw"
                />
              ) : (
                <span class="media-placeholder">After photo to supply</span>
              )}
            </div>
          </div>
          <div class="results_meta">
            <span class="results_number bracketed text-style-label" aria-hidden="true">
              <span class="results_count" />
            </span>
            <h3 class="results_title text-style-h4">{data.treatment}</h3>
            <div class="results_switch" role="group" aria-label={`${data.treatment}: photo shown`}>
              <button
                class="pill"
                type="button"
                aria-pressed="false"
                data-results-view="before"
              >
                Before
              </button>
              <button
                class="pill"
                type="button"
                aria-pressed="true"
                data-results-view="after"
              >
                After
              </button>
            </div>
          </div>
        </li>
      ))}
    </ol>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";

  onPage((signal) => {
    /* job: the Before / After switch of a case shows the other photo, by touch, mouse and keyboard; one listener for the
       page, so a case copied in OP System works with nothing more */
    document.addEventListener(
      "click",
      (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>(
          "[data-results-view]",
        );
        const card = button?.closest<HTMLElement>("[data-results-case]");
        if (!button || !card) return;
        card.dataset.view = button.dataset.resultsView;
        card
          .querySelectorAll<HTMLButtonElement>("[data-results-view]")
          .forEach((other) =>
            other.setAttribute("aria-pressed", String(other === button)),
          );
      },
      { signal },
    );
  });
</script>

<style is:global>
  @layer components {
    .results_wrap {
      align-self: stretch;
      counter-reset: result;
      --swipe-item: 78%;
      @media (width >= 48rem) and (width < 64rem) {
        --swipe-item: 46%;
      }
    }

    .results_case {
      counter-increment: result;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-width: 0;
    }

    .results_frame {
      --media-ratio: 4 / 5;
    }

    /* Both photos sit in the one frame, of one size: the switch only fades one over the other */
    .results_view {
      position: absolute;
      inset: 0;
      transition: opacity var(--duration-fast) var(--hover-ease);
    }

    .results_case[data-view="after"] .results_before,
    .results_case[data-view="before"] .results_after {
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--duration-fast) var(--hover-ease),
        visibility 0s linear var(--duration-fast);
    }

    .results_meta {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: baseline;
      column-gap: var(--space-3);
      row-gap: var(--space-3);
    }

    .results_number {
      margin: 0;
      color: var(--text-2);
    }

    .results_count::before {
      content: counter(result, decimal-leading-zero);
    }

    .results_title {
      margin: 0;
    }

    .results_switch {
      grid-column: 1 / -1;
      display: flex;
      gap: var(--space-2);
      & > .pill {
        cursor: pointer;
        transition:
          background-color var(--hover-duration) var(--hover-ease),
          color var(--hover-duration) var(--hover-ease),
          scale var(--duration-faster) var(--hover-ease);
        &:active {
          scale: 0.97;
        }
        &[aria-pressed="true"] {
          background-color: var(--button-2-background);
          color: var(--button-2-text);
        }
        @media (hover: hover) {
          &[aria-pressed="false"]:hover {
            background-color: var(--button-background-hover);
            color: var(--button-text-hover);
          }
        }
      }
    }

    /* A computer: the four cases scattered over the grid at different sizes and heights, not a row. The positions
       repeat every four, so a case added or taken away in OP System keeps the pattern. */
    @media (width >= 64rem) {
      .results_wrap {
        display: grid;
        grid-template-columns: repeat(var(--site-columns), minmax(0, 1fr));
        column-gap: var(--site-gutter);
        row-gap: var(--space-8);
        align-items: start;
      }

      .results_case:nth-child(4n + 1) {
        grid-column: 1 / span 5;
      }
      .results_case:nth-child(4n + 2) {
        grid-column: 7 / span 3;
        margin-top: calc(var(--space-8) * 2);
        & .results_frame {
          --media-ratio: 1 / 1;
        }
      }
      .results_case:nth-child(4n + 3) {
        grid-column: 3 / span 4;
        & .results_frame {
          --media-ratio: 5 / 6;
        }
      }
      .results_case:nth-child(4n + 4) {
        grid-column: 9 / span 4;
        margin-top: var(--space-8);
        & .results_frame {
          --media-ratio: 3 / 4;
        }
      }
    }
  }
</style>

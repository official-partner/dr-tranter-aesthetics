---
import Button from "@/components/Button.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The pill: label and destination. */
  pill: { label: string; href: string; figma?: string };
  /** The quiet link set against the right edge. */
  link?: { label: string; href: string; figma?: string };
  class?: string;
}
const { render = true, pill, link, class: className } = Astro.props;
---

{
  render && pill && (
    <div class:list={["action-row_wrap", className]}>
      <Button element="link" href={pill.href} data-figma={pill.figma}>{pill.label}</Button>
      {link && <Button element="link" variant="link" href={link.href} class="at-end" data-figma={link.figma}>{link.label}</Button>}
    </div>
  )
}

<style is:global>
  @layer components {
    .action-row_wrap {
      grid-column: margin / end;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--space-5);
      row-gap: var(--space-4);
      @media (48rem <= width < 64rem) {
        grid-column: main / end;
      }
      @media (width >= 64rem) {
        display: grid;
        grid-template-columns: subgrid;
        column-gap: normal;
        & > :first-child {
          grid-column: main / span 2;
          justify-self: start;
        }
      }
    }
  }
</style>

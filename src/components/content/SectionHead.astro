---
import { slotContent } from "@/utils/slots.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The small label above the heading. */
  label?: string;
  /** The heading's level. */
  tag?: "h2" | "h3";
}

const { render = true, label, tag: Tag = "h2" } = Astro.props;
const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div class="section-head_wrap column-head">
      {label && (
        <p class="section-head_label text-style-label">
          <span class="marker" aria-hidden="true" />
          {label}
        </p>
      )}
      <Tag class="section-head_heading text-style-h2">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .section-head_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .section-head_label {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin: 0;
      color: var(--text-2);
    }

    .section-head_heading {
      margin: 0;
    }
  }
</style>

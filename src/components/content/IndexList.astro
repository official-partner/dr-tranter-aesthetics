---
interface Step {
  /** The row's own id when the steps are rows of a collection's item (its key in Edit). */
  id?: string;
  title: string;
  text: string;
  /** Figma node ids for the build review: index, title, text. */
  ids?: string[];
}
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The steps, in order. */
  steps: Step[];
  /** Where the list sits: index on main and text on detail, or index on aside and text on aside-text. */
  variant?: "main" | "aside";
  /** Let the text run to the aside rail, for a list with no picture beside it (a treatment's questions). */
  wide?: boolean;
  /** Set to `false` for a list without its [01] numbers: the text then starts where the number stood. */
  numbered?: boolean;
  /** A list written in the page: its name for OP System's Modifier (items duplicated, removed, moved on the canvas). */
  list?: string;
  /** Where the steps live when they are rows of a collection's item, not written in the page:
      `astro:<collection>/<item>#<field>` (each step then needs its `id`). */
  source?: string;
  class?: string;
}
const { render = true, steps, variant = "main", wide = false, numbered = true, list, source, class: className } = Astro.props;
---

{
  render && steps?.length > 0 && (
    <ol class:list={["index-list_wrap", variant !== "main" && variant, !numbered && "is-plain", wide && "is-wide", className]} data-op-list={list} data-op-source={list && (source ?? "page")}>
      {steps.map((s, i) => (
        <li class="index-list_item" data-op-item={list && (s.id ?? String(i))}>
          {numbered && <span class="index-list_index text-style-index" data-figma={s.ids?.[0]}>[0{i + 1}]</span>}
          <div class="index-list_body stack">
            <h3 class="index-list_title text-style-index" data-op-field={source && "title"} data-figma={s.ids?.[1]}>{s.title}</h3>
            <p class="index-list_text text-style-main" data-op-field={source && "text"} data-figma={s.ids?.[2]} set:html={s.text} />
          </div>
        </li>
      ))}
    </ol>
  )
}

<style is:global>
  @layer components {
    .index-list_wrap {
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-6);
      /* on a tablet the list is a plain column, so it can sit on any rail */
      @media (48rem <= width < 64rem) {
        display: flex;
        flex-direction: column;
      }
    }
    /* an item is as wide as what it shows, never the whole grid: in OP System's Edit its outline is its own, and the
       title and text beside it stay reachable (Sam, Nov 20) */
    .index-list_item {
      grid-column: 1 / -1;
      display: flex;
      gap: var(--space-4);
      align-items: start;
      @media (width < 48rem) or (width >= 64rem) {
        display: grid;
        grid-template-columns: subgrid;
        gap: normal;
      }
    }
    /* phone: the number on the first column, the text on the three others (Sam, Nov 10) */
    @media (width < 48rem) {
      .index-list_index {
        grid-column: margin / span 1;
      }
      .index-list_body {
        grid-column: span 3 / end;
      }
    }
    .index-list_text {
      max-width: 24.7ch;
    }
    /* a title longer than its room goes to the next line (a treatment's questions on a phone) */
    .index-list_title {
      text-wrap: pretty;
    }
    /* tablet: a list on the aside goes under its text, on the main rail (a concern's factors, Our Approach's focus) */
    @media (48rem <= width < 64rem) {
      .site-grid > .index-list_wrap.aside {
        grid-row: 2;
        grid-column: main / end;
        margin-top: var(--space-7);
      }
    }
    /* unnumbered: the text starts where the number stood, on every screen */
    .index-list_wrap.is-plain .index-list_body {
      grid-column: margin / end;
    }
    @media (width >= 64rem) {
      /* the number on main, the text on the two columns after it: the list ends before the half rail, where a wide
         photo starts (Our Approach) */
      .index-list_wrap {
        grid-column: main / span 3;
      }
      .index-list_wrap.aside {
        grid-column: aside / end;
      }
      .index-list_index {
        grid-column: main;
      }
      .index-list_body {
        grid-column: detail / span 2;
      }
      .index-list_wrap.is-wide {
        grid-column: main / end;
        & .index-list_body {
          grid-column: detail / span 6;
        }
        & .index-list_text {
          max-width: none;
        }
      }
      .index-list_wrap.aside {
        & .index-list_index {
          grid-column: aside;
        }
        & .index-list_body {
          grid-column: aside-text / end;
        }
        & .index-list_text {
          max-width: 22ch;
        }
        &.is-plain .index-list_body {
          grid-column: aside / end;
        }
        &.is-plain .index-list_text {
          max-width: 29ch;
        }
      }
    }
  }
</style>

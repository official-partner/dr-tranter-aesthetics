---
interface Props {
  /** Its id: a link to `#<id>` opens it. */
  id: string;
  /** Other addresses that open it (`#enquiry-careers`), each noted on it as `data-via` while open. */
  also?: string[];
  /** The id of its title, for screen readers. */
  labelledby?: string;
  /** Its ground. */
  theme?: "dark" | "light" | "stone";
  /** An outside address it stands in front of: a link to it opens the sheet instead (Book a consultation and the
      clinic's booking page); without the script, or from inside the sheet, the link goes there. */
  catches?: string;
  /** `panel` (a pop-up): a panel rising from the foot of the screen under its mask, over a scrim, stopping
      --sheet-gap from the top. `own`: the whole screen, its page moves it (`sheet:open`, `sheet:close`, below; Our
      team's profile). With reduced motion both fade. */
  motion?: "panel" | "own";
  class?: string;
  [key: string]: unknown;
}
const { id, also = [], labelledby, theme = "dark", catches, motion = "panel", class: className, ...rest } = Astro.props;
const panel = motion === "panel";
/* a pop-up's panel holds the layout (its ground, its scroll); the whole-screen sheet is the layout itself */
const Panel = panel ? "div" : Fragment;
const panelProps = panel ? { class: `sheet_panel theme-${theme}` } : {};
---

{/* A sheet over the page: a pop-up (Send an enquiry, Book a consultation: Figma 4001:265, 4001:237) or a team
    member's profile (4001:958, the whole screen), with its Back, on the site's grid. A link to its address opens it and
    the address shows it (/team#sarah-tranter can be shared and opens it); Back, Escape, the browser's back and, for a
    pop-up, the scrim above it close it. Without the script the links stay plain anchors. */}
<dialog class:list={["sheet_wrap", panel ? "is-panel" : `theme-${theme}`, className]} id={id} aria-labelledby={labelledby} data-sheet-also={also.join(" ") || undefined} data-lenis-prevent data-sheet-motion={panel ? undefined : "own"} data-sheet-catch={catches} {...rest}>
  <Panel {...panelProps}>
    {/* Back stays in reach while the sheet scrolls (Sam, Nov 26): a bar of no height held at the top of the scroll,
        Back in it at its place on the grid; a stand-in of the same words keeps that place in the layout */}
    <div class="sheet_bar site-grid">
      <button type="button" class="sheet_back text-style-action" data-sheet-close>
        <span aria-hidden="true">←</span> Back
      </button>
    </div>
    <div class="sheet_layout site-grid section-padding">
      <span class="sheet_back sheet_back-space text-style-action" aria-hidden="true">← Back</span>
      <slot />
    </div>
  </Panel>
</dialog>

<style is:global>
  @layer components {
    .sheet_wrap {
      position: fixed;
      inset: 0;
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      overscroll-behavior: contain;
      &::backdrop {
        background: transparent;
      }
    }
    /* The whole screen (Our team's profile): its page's script carries it in and out; with reduced motion it fades
       (--open-duration). */
    .sheet_wrap[data-sheet-motion="own"] {
      overflow-y: auto;
      & .sheet_layout {
        min-height: 100%;
      }
      @media (prefers-reduced-motion: reduce) {
        opacity: 0;
        transition:
          opacity var(--open-duration) var(--ease-smooth),
          overlay var(--open-duration) allow-discrete,
          display var(--open-duration) allow-discrete;
        &[open] {
          opacity: 1;
          @starting-style {
            opacity: 0;
          }
        }
      }
    }
    /* A pop-up (Sam, Nov 26: « arrive de bas en haut avec un overlay derrière... en clip masque... un gap en haut
       d'à peu près 15 vh »), in step with a page change: the scrim darkens the page (--sheet-scrim of the ink, over
       --sheet-scrim-duration) while the panel rises from the foot of the screen under its mask, as an arriving page
       does (clip-path and --page-shift, --sheet-duration on --sheet-ease), and stops --sheet-gap from the top; it
       scrolls inside. Closing: the same gesture backwards (Sam, Nov 26: « la même transition que l'apparition »), it
       goes back down under its mask (--sheet-leave-duration on --sheet-leave-ease, the arrival's own) as the scrim
       clears. A click on the scrim closes it. Reduced motion: both fade. */
    .sheet_wrap.is-panel {
      overflow: hidden;
      background: transparent;
      &::backdrop {
        background-color: color-mix(in srgb, var(--ink) var(--sheet-scrim), transparent);
      }
      &[open]::backdrop {
        animation: sheet-scrim var(--sheet-scrim-duration) var(--ease-smooth) backwards;
      }
      /* its own keyframes: the same name played in reverse would not start again, it would cut to its end */
      &[data-leaving]::backdrop {
        animation: sheet-scrim-out var(--sheet-leave-duration) var(--ease-smooth) forwards;
      }
      & .sheet_panel {
        position: absolute;
        inset: var(--sheet-gap) 0 0;
        overflow-y: auto;
        overscroll-behavior: contain;
      }
      &[open] .sheet_panel {
        animation: sheet-rise var(--sheet-duration) var(--sheet-ease) backwards;
      }
      &[data-leaving] .sheet_panel {
        animation: sheet-sink var(--sheet-leave-duration) var(--sheet-leave-ease) forwards;
      }
      @media (prefers-reduced-motion: reduce) {
        &[open] .sheet_panel {
          animation-name: sheet-scrim;
        }
        &[data-leaving] .sheet_panel {
          animation-name: sheet-scrim-out;
        }
      }
    }
    @keyframes sheet-rise {
      from {
        clip-path: inset(100% 0 0 0);
        translate: 0 var(--page-shift);
      }
      to {
        clip-path: inset(0 0 0 0);
        translate: 0 0;
      }
    }
    @keyframes sheet-sink {
      from {
        clip-path: inset(0 0 0 0);
        translate: 0 0;
      }
      to {
        clip-path: inset(100% 0 0 0);
        translate: 0 var(--page-shift);
      }
    }
    @keyframes sheet-scrim {
      from {
        opacity: 0;
      }
    }
    @keyframes sheet-scrim-out {
      to {
        opacity: 0;
      }
    }
    .sheet_layout {
      row-gap: var(--space-7);
      align-content: start;
    }
    /* a sheet's head ends on a hairline, edge to edge (Send an enquiry, Book a consultation) */
    .sheet_rule {
      grid-column: margin / end;
      margin: var(--space-10) calc(var(--site-margin) * -1) 0;
      border: 0;
      border-top: var(--border-width) solid var(--text-3);
    }
    .sheet_bar {
      position: sticky;
      top: 0;
      z-index: var(--z-raised);
      height: 0;
      overflow: visible;
    }
    .sheet_back {
      grid-column: margin / end;
      justify-self: start;
      display: inline-flex;
      gap: var(--space-2);
      color: var(--text-2);
    }
    /* the button on the sheet's ground, so what scrolls under it never shows through its words */
    .sheet_bar .sheet_back {
      margin-top: calc(var(--section-padding) - var(--space-2));
      margin-left: calc(var(--space-2) * -1);
      padding: var(--space-2);
      border: 0;
      background-color: var(--background);
      cursor: pointer;
      transition: color var(--hover-duration) var(--hover-ease);
      &:hover {
        color: var(--text);
      }
    }
    .sheet_back-space {
      visibility: hidden;
    }
    @media (width >= 48rem) {
      .sheet_back {
        grid-column: margin / main;
      }
      .sheet_back-space {
        grid-row: 1;
        align-self: start;
      }
    }
    /* a block of the sheet set on the lighter ground (the stone), its words and its form or its way on (Send an
       enquiry, Book a consultation; Sam, Nov 26: « un mix de light et de blanc ») */
    .sheet_card {
      padding: var(--space-6);
    }
  }
</style>
<script>
  import { onPage } from "@/utils/page";
  import { navigate } from "astro:transitions/client";

  /* Opening and closing, with the address. A sheet's address is a step of the history made by the site's router, as
     any link to a place on the page (a link to `#<id>`; a link a sheet stands in front of goes to its address the same
     way): the router changes the address without a page change, and the sheet follows the address (`sync`). The
     browser's back and forward go through the router too, which keeps them on the page (Sam, Nov 26, comments 31 and
     34: Back read as a page change when the sheet made its own steps). A shared address opens its sheet with its page.
     The sheet tells its page as it opens (`sheet:open`, with the link pressed and what had the focus) and before it
     closes (`sheet:close`: `wait(promise)` holds it open until the page's motion has ended). */
  const sheets = () => [...document.querySelectorAll<HTMLDialogElement>(".sheet_wrap")];
  const find = (hash: string) => (hash ? sheets().find((d) => d.id === hash || (d.dataset.sheetAlso ?? "").split(" ").includes(hash)) : undefined);
  const calm = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
  const ms = (name: string) => {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return (parseFloat(v) || 0) * (v.endsWith("ms") ? 1 : 1000);
  };
  /* the link just pressed, handed to the sheet its address opens */
  let pressed: { a: Element; hash: string } | null = null;

  /* `stepped`: opened by a step of the history (a link, the browser's forward), so closing goes back a step */
  const open = (d: HTMLDialogElement, hash: string, trigger: Element | null, stepped: boolean) => {
    if (d.open) return;
    d.dataset.via = hash;
    d.dataset.stepped = stepped ? "true" : "";
    const panel = d.querySelector<HTMLElement>(".sheet_panel");
    d.scrollTop = 0;
    if (panel) panel.scrollTop = 0;
    /* where the focus goes back to when it closes */
    const from = document.activeElement;
    d.showModal();
    d.dispatchEvent(new CustomEvent("sheet:open", { detail: { trigger, from } }));
    d.querySelector<HTMLElement>("[data-sheet-close]")?.focus({ preventScroll: true });
  };
  const close = (d: HTMLDialogElement) => {
    if (!d.open || d.dataset.closing !== undefined) return;
    const waits: Promise<unknown>[] = [];
    d.dispatchEvent(new CustomEvent("sheet:close", { detail: { wait: (p: Promise<unknown>) => waits.push(p) } }));
    /* a pop-up goes back down under its mask first */
    const panel = d.querySelector<HTMLElement>(".sheet_panel");
    if (panel) {
      d.dataset.leaving = "";
      waits.push(
        new Promise<void>((done) => {
          const t = setTimeout(done, ms("--sheet-leave-duration") + 100);
          panel.addEventListener("animationend", () => (clearTimeout(t), done()), { once: true });
        }),
      );
    }
    d.dataset.closing = "";
    Promise.all(waits).finally(() => {
      delete d.dataset.closing;
      delete d.dataset.leaving;
      d.close();
    });
  };
  /* Back, Escape, the scrim: a step back when a step opened it, else closed and its address taken off */
  const leave = (d: HTMLDialogElement) => {
    if (d.dataset.stepped && location.hash === `#${d.dataset.via}`) return history.back();
    close(d);
    if (location.hash) history.replaceState(history.state, "", location.pathname + location.search);
  };
  /* the sheets follow the address */
  const sync = () => {
    const hash = location.hash.slice(1);
    const target = find(hash);
    sheets().forEach((d) => d !== target && close(d));
    if (target && !target.open) {
      const trigger = pressed?.hash === hash ? pressed.a : null;
      pressed = null;
      open(target, hash, trigger, true);
    }
  };
  if (!(window as { __sheetHistory?: boolean }).__sheetHistory) {
    (window as { __sheetHistory?: boolean }).__sheetHistory = true;
    addEventListener("popstate", () => queueMicrotask(sync));
    addEventListener("hashchange", sync);
  }

  onPage((signal) => {
    document.addEventListener(
      "click",
      (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[href]");
        if (!a) return;
        const href = a.getAttribute("href") ?? "";
        if (href.startsWith("#")) {
          /* a link to a sheet: the router (or the browser) makes the step, the sheet follows */
          if (find(href.slice(1))) pressed = { a, hash: href.slice(1) };
          return;
        }
        /* a link to an address a sheet stands in front of (never from inside it): that sheet's address instead */
        let url: URL;
        try {
          url = new URL(a.href);
        } catch {
          return;
        }
        const d = sheets().find((s) => {
          if (!s.dataset.sheetCatch || s.contains(a)) return false;
          const c = new URL(s.dataset.sheetCatch, location.href);
          return c.origin === url.origin && c.pathname === url.pathname;
        });
        if (!d) return;
        e.preventDefault();
        pressed = { a, hash: d.id };
        navigate(`#${d.id}`);
      },
      /* before the router's own listener, so a caught link never reaches it */
      { signal, capture: true },
    );
    sheets().forEach((d) => {
      d.querySelector("[data-sheet-close]")?.addEventListener("click", () => leave(d), { signal });
      /* a pop-up: a click on the scrim, outside its panel */
      d.addEventListener("click", (e) => e.target === d && d.classList.contains("is-panel") && leave(d), { signal });
      d.addEventListener(
        "cancel",
        (e) => {
          e.preventDefault();
          leave(d);
        },
        { signal },
      );
      /* closed another way (a second Escape closes a dialog at once): its address goes too */
      d.addEventListener("close", () => d.dataset.stepped && location.hash === `#${d.dataset.via}` && history.back(), { signal });
    });
    /* an address that names a sheet opens it over its page, once the page's own scripts are ready to move it */
    const hash = location.hash.slice(1);
    const d = find(hash);
    if (d) setTimeout(() => open(d, hash, null, false), 0);
  });
</script>

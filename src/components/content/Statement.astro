---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The statement, broken by hand into its lines. A line may carry `<span class="weight-regular">` for the heavier
   * word of the two-weight sentence. */
  lines: string[];
  /** Heading level: the page's h1, or an h2. */
  tag?: "h1" | "h2";
}

const { render = true, lines, tag: Tag = "h1" } = Astro.props;
---

{
  render && lines?.length > 0 && (
    <Tag class="statement_wrap text-style-h1">
      {lines.map((line, index) => (
        <>
          <span class="statement_line">
            <span
              class="statement_inner"
              style={`--i: ${index}`}
              set:html={line}
            />
          </span>
          {index < lines.length - 1 && " "}
        </>
      ))}
    </Tag>
  )
}

<style is:global>
  @layer components {
    /* The page's one opening: the lines rise from their masks, once, on the arrive curve (base, 0.08 between lines).
       The text is in its place without it; reduced motion has no travel; a loading screen holds it until it leaves. */
    .statement_wrap {
      margin: 0;
      text-wrap: wrap;
    }

    .statement_line {
      display: block;
      overflow: clip;
      /* room for the descenders of a line set at line height 1 */
      padding-block: 0.12em;
      margin-block: -0.12em;
    }

    .statement_inner {
      display: block;
      animation: statement-rise var(--duration-base) var(--ease-osmo) both;
      animation-delay: calc(var(--i) * 80ms);
    }

    html[data-loader="play"] .statement_inner {
      animation-play-state: paused;
    }

    @media (prefers-reduced-motion: reduce) {
      .statement_inner {
        animation: none;
      }
    }

    @keyframes statement-rise {
      from {
        transform: translateY(110%);
      }
    }
  }
</style>

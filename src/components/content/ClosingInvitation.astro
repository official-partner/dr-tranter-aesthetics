---
import Button from "@/components/Button.astro";
import Section from "@/components/wrapper/Section.astro";
import type { Theme } from "@/types.ts";
import { BOOK_URL } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The sentence of the invitation. */
  heading: string;
  /** Color theme of the band. */
  theme?: Theme;
}

const { render = true, heading, theme = "stone" } = Astro.props;
---

{
  render && heading && (
    <Section theme={theme} paddingTop="small" paddingBottom="medium">
      <div class="closing-invitation_layout site-grid">
        <p class="closing-invitation_label column-head text-style-label">
          <span class="marker" aria-hidden="true" />
          Where to start?
        </p>
        <h2 class="closing-invitation_heading text-style-h2">{heading}</h2>
        <div class="closing-invitation_action">
          <Button element="link" href={BOOK_URL}>
            Book a consultation
          </Button>
        </div>
      </div>
    </Section>
  )
}

<style is:global>
  @layer components {
    .closing-invitation_layout {
      row-gap: var(--space-5);
      align-items: start;
    }

    .closing-invitation_label {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin: 0;
      grid-column: 1 / -1;
      @media (width >= 64rem) {
        grid-column: 1 / span var(--head-span);
      }
    }

    .closing-invitation_heading {
      margin: 0;
      grid-column: 1 / -1;
      @media (width >= 64rem) {
        grid-column: var(--body-start) / span 5;
      }
    }

    .closing-invitation_action {
      grid-column: 1 / -1;
      display: flex;
      @media (width < 48rem) {
        & > .button_wrap {
          flex: 1;
        }
      }
      @media (width >= 64rem) {
        grid-column: 10 / -1;
        justify-content: flex-end;
      }
    }
  }
</style>

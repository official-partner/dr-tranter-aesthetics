---
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import { getItems, img } from "@/utils/content";
import { dayFirst } from "@/utils/dates.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** How many articles to show: the home shows three. All of them when it is left out. */
  limit?: number;
}

const { render = true, limit } = Astro.props;

const articles = (await getItems("articles")).slice(0, limit);
---

{
  render && articles.length > 0 && (
    <ul
      class="journal_wrap swipe-row"
      data-op-list="articles"
      data-op-source="astro:articles"
    >
      {articles.map(({ id, data }) => (
        <li class="journal_card" data-op-item={id}>
          <a
            class="journal_photo-link"
            href={`/journal/${id}`}
            tabindex="-1"
            aria-hidden="true"
          >
            <span class="journal_photo media-frame">
              {data.photo ? (
                <Img
                  {...img(data.photo)}
                  alt=""
                  variant="constrained"
                  sizes="(min-width: 64rem) 30vw, 78vw"
                />
              ) : (
                <span class="media-placeholder">Photo to supply</span>
              )}
            </span>
          </a>
          {data.date && (
            <time
              class="journal_date bracketed text-style-label"
              datetime={data.date.toISOString().slice(0, 10)}
              data-op-field="date"
            >
              {dayFirst(data.date)}
            </time>
          )}
          <h3 class="journal_title text-style-h3" data-op-field="title">
            <a href={`/journal/${id}`}>{data.title}</a>
          </h3>
          <div class="journal_more">
            <Button
              element="link"
              variant="link"
              href={`/journal/${id}`}
              aria-label={`Read the article: ${data.title}`}
            >
              Read the article
            </Button>
          </div>
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @layer components {
    .journal_wrap {
      align-self: stretch;
      --swipe-item: 78%;
      @media (width >= 48rem) and (width < 64rem) {
        --swipe-item: 46%;
      }
      @media (width >= 64rem) {
        display: grid;
        grid-template-columns: repeat(var(--site-columns), minmax(0, 1fr));
        column-gap: var(--site-gutter);
      }
    }

    .journal_card {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      min-width: 0;
      @media (width >= 64rem) {
        grid-column: span 4;
      }
    }

    .journal_photo-link {
      display: block;
    }

    .journal_photo {
      display: block;
      --media-ratio: 4 / 3;
    }

    .journal_date {
      margin: var(--space-2) 0 0;
      color: var(--text-2);
    }

    .journal_title {
      margin: 0;
      /* the titles are of different lengths: the links sit on one line across the cards */
      flex: 1;
      text-wrap: pretty;
      & a {
        text-decoration: none;
        transition: color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover {
            color: var(--text-2);
          }
        }
      }
    }

    .journal_more {
      margin-top: var(--space-2);
    }
  }
</style>

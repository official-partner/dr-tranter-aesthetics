---
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import { pic, type Pic } from "@/utils/media";

interface Item {
  /** The concern's id in the collection. */
  id?: string;
  label: string;
  category?: string;
  href: string;
  image?: Pic;
}
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The concerns, in order. */
  items: Item[];
}
const { render = true, items } = Astro.props;
---

{
  render && items?.length > 0 && (
    <ul class="concern-index_list text-style-display" data-figma="1:81" data-cap-offset="0.1895" data-op-list="concerns" data-op-source="astro:concerns">
      {items.map((item) => (
        <li class="concern-index_item" data-op-item={item.id}>
          <span class="concern-index_category text-style-label inset-optical" data-op-field="group" data-figma={item.category === "Structure" ? "1:84" : undefined}>{item.category}</span>
          {item.image && (
            <span class="concern-index_thumb media" data-figma="1:82">
              <Img {...pic(item.image)} alt="" variant="constrained" sizes="10rem" />
            </span>
          )}
          <span class="concern-index_marker marker" data-figma="1:88" />
          <a class="concern-index_link" data-op-field="name" href={item.href} data-cap-offset="0.1895" data-figma={item.label === "Temple hollowing" ? "1:83" : undefined}>{item.label}</a>
          <span class="concern-index_action">
            <Button element="link" href={item.href} tabindex="-1" data-figma="1:188">Learn more</Button>
          </span>
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @layer components {
    .concern-index_list {
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
      text-box: none;
      margin-block: -0.1895em;
      color: var(--text-3);
    }
    .concern-index_item {
      position: relative;
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
      --_mid: calc(var(--display) * 0.651);
    }
    .concern-index_link {
      grid-column: main / end;
      color: inherit;
    }
    .concern-index_category,
    .concern-index_thumb,
    .concern-index_marker,
    .concern-index_action {
      position: absolute;
      top: var(--_mid);
      translate: 0 -50%;
      visibility: hidden;
      color: var(--text);
    }
    .concern-index_category {
      grid-column: margin / inset;
    }
    .concern-index_thumb {
      grid-column: inset;
      width: 100%;
    }
    .concern-index_action {
      grid-column: aside / end;
      justify-self: end;
      display: flex;
    }
    .concern-index_item:is(:hover, :focus-within) {
      & .concern-index_link {
        grid-column: detail / end;
        color: var(--text);
        font-weight: var(--h2-font-weight);
        font-variation-settings: var(--h2-font-variation);
      }
      & :is(.concern-index_category, .concern-index_thumb, .concern-index_marker, .concern-index_action) {
        visibility: visible;
      }
    }
    @media (width < 48rem) {
      .concern-index_link,
      .concern-index_item:is(:hover, :focus-within) .concern-index_link {
        grid-column: margin / end;
      }
    }
    @media (48rem <= width < 64rem) {
      .concern-index_item:is(:hover, :focus-within) .concern-index_link {
        grid-column: main / end;
      }
    }
    @media (width < 64rem) {
      .concern-index_category,
      .concern-index_thumb,
      .concern-index_marker,
      .concern-index_action {
        display: none;
      }
    }
  }
</style>

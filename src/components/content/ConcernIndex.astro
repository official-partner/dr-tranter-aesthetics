---
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import { pic, type Pic } from "@/utils/media";

interface Item {
  /** The item's id in its collection. */
  id?: string;
  label: string;
  /** A second line under the name (a person's role). */
  sub?: string;
  category?: string;
  href: string;
  image?: Pic;
}
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The items, in order. */
  items: Item[];
  /** `concerns`: the large names of the home's list; `people`: a name and its role, the others dimmed when one is
      chosen (Our team, Figma 4001:904 and 934). */
  variant?: "concerns" | "people";
  /** The button's words. */
  action?: string;
  /** The list's name and source for OP System. */
  list?: string;
  source?: string;
}
const { render = true, items, variant = "concerns", action = "Learn more", list = "concerns", source = "astro:concerns" } = Astro.props;
const people = variant === "people";
---

{
  render && items?.length > 0 && (
    <div class:list={["concern-index_wrap", people && "is-people"]}>
      <ul class:list={["concern-index_list", !people && "text-style-display"]} data-figma={people ? undefined : "1:81"} data-cap-offset={people ? undefined : "0.1895"} data-op-list={list} data-op-source={source}>
        {items.map((item, i) => (
          <li class:list={["concern-index_item", i > 0 && item.category !== items[i - 1].category && "is-group-start"]} data-op-item={item.id}>
            {item.category && <span class="concern-index_category text-style-label inset-optical" data-op-field="group" data-figma={item.category === "Structure" ? "1:84" : undefined}><span class="concern-index_word">{item.category}</span></span>}
            {item.image && (
              <span class="concern-index_thumb media" data-figma={people ? undefined : "1:82"}>
                <Img {...pic(item.image)} alt="" variant="constrained" sizes="10rem" />
              </span>
            )}
            <span class="concern-index_marker marker" data-figma={people ? undefined : "1:88"} />
            {people ? (
              <a class="concern-index_link" href={item.href}>
                <span class="concern-index_name text-style-label" data-op-field="name">{item.label}</span>
                {item.sub && <span class="concern-index_sub text-style-serif" data-op-field="role">{item.sub}</span>}
              </a>
            ) : (
              <a class="concern-index_link" data-op-field="name" href={item.href} data-cap-offset="0.1895" data-figma={item.label === "Temple hollowing" ? "1:83" : undefined}>{item.label}</a>
            )}
            <span class="concern-index_action">
              <Button element="link" href={item.href} tabindex="-1" data-figma={people ? undefined : "1:188"}>{action}</Button>
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  /* A concern's name moves between two cuts of Season (Sam, comment 6, Nov 22: « animer la font variable de façon
     smooth, entre les states de la font variable, comme on avait dans le brand guide »): its axis and its weight are
     two numbers the browser can move between, as in the brand guide's accent switch. Mix Regular at rest, Sans Medium
     when chosen. */
  @property --_cut-axis {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --_cut-weight {
    syntax: "<number>";
    inherits: true;
    initial-value: 400;
  }
  @layer components {
    /* the list, its rows and, beside the list, the set that travels along it (the script below): subgrids, so all
       sit on the rails */
    .concern-index_wrap,
    .concern-index_list,
    .concern-index_item {
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
    }
    .concern-index_wrap,
    .concern-index_item {
      position: relative;
    }
    .concern-index_list {
      text-box: none;
      margin-block: -0.1895em;
      color: var(--text-3);
    }
    .concern-index_item {
      --_mid: calc(var(--display) * 0.651);
    }
    /* the next group starts a little apart (Sam, Nov 25: « un petit espacement entre les deux types »; Figma 4001:32) */
    .concern-index_item.is-group-start {
      margin-top: var(--space-5);
    }
    /* the name stays on its rail when chosen (Sam, comment 6: « enlever le mouvement du texte vers la droite »); only
       its colour and its cut change */
    .concern-index_link {
      grid-column: main / end;
      color: inherit;
      --_cut-axis: var(--display-font-axis);
      --_cut-weight: var(--display-font-weight);
      font-weight: var(--_cut-weight);
      font-variation-settings: "SERF" var(--_cut-axis), "wght" var(--_cut-weight);
      transition:
        color var(--hover-duration) var(--hover-ease),
        --_cut-axis var(--cut-duration) var(--cut-ease),
        --_cut-weight var(--cut-duration) var(--cut-ease);
    }
    .concern-index_category,
    .concern-index_thumb,
    .concern-index_marker,
    .concern-index_action {
      position: absolute;
      top: var(--_mid);
      translate: 0 -50%;
      visibility: hidden;
      color: var(--text);
    }
    .concern-index_category {
      grid-column: margin / inset;
      /* its word rolls in it when the group changes (the script below): a little room for the letters' edges */
      overflow: clip;
      padding-block: 0.2em;
    }
    .concern-index_word {
      display: block;
    }
    .concern-index_thumb {
      grid-column: inset;
      width: 100%;
    }
    .concern-index_action {
      grid-column: aside / end;
      justify-self: end;
      display: flex;
    }
    .concern-index_item:is(:hover, :focus-within) {
      & .concern-index_link {
        color: var(--text);
        --_cut-axis: var(--h2-font-axis);
        --_cut-weight: var(--h2-font-weight);
      }
      & :is(.concern-index_category, .concern-index_thumb, .concern-index_marker, .concern-index_action) {
        visibility: visible;
      }
    }

    /* The travelling set (the script below, a mouse on a computer): one group name, one frame, one square and one
       button for the whole list, which glide to the chosen row; the rows' own sets stay hidden. */
    .concern-index_wrap[data-follow] .concern-index_item :is(.concern-index_category, .concern-index_thumb, .concern-index_marker, .concern-index_action) {
      visibility: hidden;
    }
    .concern-index_wrap > .is-follow {
      top: 0;
      translate: 0 calc(var(--_follow-y, 0%) - 50%);
      visibility: visible;
      opacity: 0;
      pointer-events: none;
      transition:
        translate var(--follow-duration) var(--ease-smooth),
        opacity var(--hover-duration) var(--hover-ease);
    }
    .concern-index_wrap[data-follow="on"] > .is-follow {
      opacity: 1;
      &.concern-index_action {
        pointer-events: auto;
      }
      &.concern-index_thumb.is-empty {
        opacity: 0;
      }
    }
    /* placed at once where the pointer comes in, then it travels */
    .concern-index_wrap.is-placing > .is-follow {
      transition: opacity var(--hover-duration) var(--hover-ease);
    }
    /* one frame, the photo changing inside it (Sam, comment 4: « le même bloc d'image, seulement l'image à
       l'intérieur change »): the next photo fades in over the last, which goes once it is covered */
    .concern-index_thumb.is-follow > img {
      animation: none;
      opacity: 0;
      transition: opacity 0s linear var(--follow-image-duration);
      &.is-on {
        z-index: 1;
        opacity: 1;
        transition: opacity var(--follow-image-duration) var(--hover-ease);
      }
    }
    /* one label, its words stacked in it: the group's word rolls in its mask when the group changes, up going down
       the list, down coming back (Sam, comment 5: « j'aime l'idée du texte switch en masque mais c'est buggy ») */
    .concern-index_category.is-follow {
      display: grid;
      & > .concern-index_word {
        grid-area: 1 / 1;
        translate: 0 var(--_word-y, 0%);
        transition: translate var(--roll-duration) var(--ease-smooth);
      }
    }
    .concern-index_wrap.is-placing .concern-index_word {
      transition: none;
    }

    /* people (Our team): a name and its role, a step apart; when one is chosen the others dim (--people-dim, as the
       home's team list) and its photo, square and Full profile show beside it, on the row's middle */
    .concern-index_wrap.is-people {
      /* the list ends tall, room for its photo beside the last name (Sam, Nov 25, comment 23: the Figma's 317) */
      padding-bottom: calc(var(--section-padding-tall) - var(--section-padding));
      & .concern-index_list {
        row-gap: var(--space-6);
        margin-block: 0;
        color: var(--text);
      }
      & .concern-index_item {
        --_mid: 50%;
      }
      & .concern-index_link {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        justify-self: start;
        transition: opacity var(--hover-duration) var(--hover-ease);
      }
      & .concern-index_list:has(.concern-index_item:is(:hover, :focus-within)) .concern-index_item:not(:hover, :focus-within) .concern-index_link {
        opacity: var(--people-dim);
      }
    }
    @media (width < 48rem) {
      .concern-index_link {
        grid-column: margin / end;
      }
    }
    @media (width < 64rem) {
      .concern-index_category,
      .concern-index_thumb,
      .concern-index_marker,
      .concern-index_action {
        display: none;
      }
    }
  }
</style>

<script>
  import { onPage } from "@/utils/page";

  /* The list's hover as one set of things (Sam, Nov 21: « les éléments sont les mêmes, le bouton, le carré, la photo:
     ils se déplacent et changent, mais ça reste le même élément »; Nov 22, comments 4 and 5: the photo's frame and the
     group's name must be one element too, at any speed). Each row keeps its own square, photo, button and group name,
     as the page is written: that is the list without this script, with reduced motion, on a tablet and a phone. With a
     mouse on a computer, the script lays one set beside the list and moves it to the chosen row: CSS transitions carry
     it, so a quick pass changes course from wherever it is, never restarting. The photo changes inside the one frame,
     the group's word rolls inside the one label, the button links to the chosen concern. Its job: show which concern
     is chosen, and that the list is one object. */
  onPage((signal) => {
    const able = matchMedia("(hover: hover) and (pointer: fine) and (width >= 64rem)");
    const calm = matchMedia("(prefers-reduced-motion: reduce)");
    document.querySelectorAll<HTMLElement>(".concern-index_wrap").forEach((wrap) => {
      const list = wrap.querySelector<HTMLElement>(".concern-index_list");
      if (!list) return;
      const part = (li: HTMLElement, name: string) => li.querySelector<HTMLElement>(`:scope > .concern-index_${name}`);
      const groupOf = (li: HTMLElement) => part(li, "category")?.textContent?.trim() ?? "";
      type Follow = { all: HTMLElement[]; thumb: HTMLElement | null; link: HTMLAnchorElement | null; words: HTMLElement[]; images: (HTMLElement | null)[] };
      let rows: HTMLElement[] = [];
      let groups: string[] = [];
      let set: Follow | null = null;
      let current: HTMLElement | null = null;

      /* a copy of a row's part for the set: what ties the row to the design and to OP's Modifier stays on the row */
      const copy = (el: HTMLElement, deep: boolean) => {
        const c = el.cloneNode(deep) as HTMLElement;
        for (const n of [c, ...c.querySelectorAll<HTMLElement>("*")]) {
          n.removeAttribute("data-figma");
          n.removeAttribute("data-op-field");
        }
        c.classList.add("is-follow");
        c.setAttribute("aria-hidden", "true");
        return c;
      };
      const build = () => {
        wrap.querySelectorAll(":scope > .is-follow").forEach((n) => n.remove());
        rows = [...list.querySelectorAll<HTMLElement>(":scope > .concern-index_item")];
        groups = [...new Set(rows.map(groupOf))];
        const from = (name: string) => rows.map((r) => part(r, name)).find(Boolean) ?? null;
        const category = from("category");
        const marker = from("marker");
        const action = from("action");
        if (!marker || !action) return (set = null);
        /* a list with groups has one label whose word rolls; a list of people has none */
        const label = category ? copy(category, false) : null;
        const words = label
          ? groups.map((g) => {
              const w = document.createElement("span");
              w.className = "concern-index_word";
              w.textContent = g;
              label.append(w);
              return w;
            })
          : [];
        const frame = from("thumb");
        const thumb = frame ? copy(frame, false) : null;
        const images = rows.map((r) => {
          const img = part(r, "thumb")?.querySelector<HTMLElement>("img");
          if (!img || !thumb) return null;
          const c = img.cloneNode(true) as HTMLElement;
          thumb.append(c);
          return c;
        });
        const button = copy(action, true);
        set = {
          all: [...(label ? [label] : []), ...(thumb ? [thumb] : []), copy(marker, false), button],
          thumb,
          link: button.querySelector("a"),
          words,
          images,
        };
        wrap.append(...set.all);
      };

      const place = (row: HTMLElement, instant: boolean) => {
        if (!set) return;
        const box = wrap.getBoundingClientRect();
        const mark = part(row, "marker")!.getBoundingClientRect();
        if (instant) wrap.classList.add("is-placing");
        wrap.style.setProperty("--_follow-y", `${mark.top + mark.height / 2 - box.top}px`);
        const g = groups.indexOf(groupOf(row));
        set.words.forEach((w, i) => w.style.setProperty("--_word-y", i === g ? "0%" : i < g ? "-140%" : "140%"));
        const at = rows.indexOf(row);
        set.images.forEach((img, i) => img?.classList.toggle("is-on", i === at));
        set.thumb?.classList.toggle("is-empty", !set.images[at]);
        const href = part(row, "link")?.getAttribute("href");
        if (set.link && href) set.link.setAttribute("href", href);
        if (instant) {
          /* the new place is taken before the transitions come back */
          getComputedStyle(set.all[0]).translate;
          wrap.classList.remove("is-placing");
        }
      };

      const on = () => able.matches && !calm.matches;
      const sync = () => {
        if (!on()) {
          delete wrap.dataset.follow;
          current = null;
          return;
        }
        if (!set) build();
        wrap.dataset.follow = current ? "on" : "rest";
      };
      const go = (row: HTMLElement | null) => {
        if (!on() || row === current) return;
        if (!set) build();
        const was = current;
        current = row;
        if (row) place(row, !was);
        wrap.dataset.follow = row ? "on" : "rest";
      };

      sync();
      able.addEventListener("change", sync, { signal });
      calm.addEventListener("change", sync, { signal });
      wrap.addEventListener("pointerover", (e) => {
        const t = e.target as HTMLElement;
        if (t.closest(".is-follow")) return;
        const row = t.closest<HTMLElement>(".concern-index_item");
        if (row) go(row);
      }, { signal });
      wrap.addEventListener("pointerleave", () => go(null), { signal });
      /* the travelling button takes focus when pressed: it is the chosen row's, the set stays (else the press would hide
         it before the click lands) */
      wrap.addEventListener("focusin", (e) => {
        const t = e.target as HTMLElement;
        if (t.closest(".is-follow")) return;
        go(t.closest<HTMLElement>(".concern-index_item"));
      }, { signal });
      wrap.addEventListener("focusout", (e) => { if (!wrap.contains(e.relatedTarget as Node)) go(null); }, { signal });
      window.addEventListener("resize", () => current && place(current, true), { signal });
      /* OP's Modifier copied, removed or moved a row: the set is made again from the rows as they are */
      list.addEventListener("op:list", () => {
        set = null;
        current = null;
        sync();
      }, { signal });
    });
  });
</script>

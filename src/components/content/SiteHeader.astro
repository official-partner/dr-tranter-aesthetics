---
import Button from "@/components/Button.astro";
import Wordmark from "@/components/content/Wordmark.astro";
import SiteMenu from "@/components/content/SiteMenu.astro";
import { BOOK_URL } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <header class="site-header_wrap theme-burgundy" data-open="false">
      <div class="site-header_bar">
        <Wordmark />
        <div class="site-header_actions">
          <Button
            element="link"
            href={BOOK_URL}
            aria-label="Book a consultation"
          >
            Book<span class="site-header_more"> a consultation</span>
          </Button>
          <button
            class="site-header_toggle"
            type="button"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="site-menu"
            data-menu-toggle
          >
            <span class="site-header_icon" aria-hidden="true"></span>
          </button>
        </div>
      </div>
      <SiteMenu />
    </header>
  )
}

<style is:global>
  @layer components {
    .site-header_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      padding-inline: var(--site-margin);
      /* The bar holds still while the page changes (PageTransitions) */
      view-transition-name: site-nav;
    }

    .site-header_bar {
      width: 100%;
      max-width: var(--max-width-main);
      margin-inline: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
    }

    .site-header_actions {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    /* On a phone the pill shortens to « Book » */
    .site-header_more {
      @media (width < 48rem) {
        display: none;
      }
    }

    .site-header_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: var(--nav-height);
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.7;
        }
      }
    }

    .site-header_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--duration-fast) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .site-header_wrap[data-open="true"] .site-header_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    /* The page stays put under an open menu */
    html:has(.site-header_wrap[data-open="true"]) {
      overflow: hidden;
    }
  }
</style>

---
interface Step {
  title: string;
  text?: string;
}

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The steps, in order. */
  items: Step[];
  /** The list's name for OP System's Modifier. */
  name?: string;
  /** Where the steps are written: `page` or a file's path. */
  source?: string;
}

const { render = true, items, name = "steps", source = "page" } = Astro.props;
---

{
  render && items?.length > 0 && (
    <ol class="step-list_wrap" data-op-list={name} data-op-source={source}>
      {items.map((step) => (
        <li class="step-list_item" data-op-item="">
          <span class="step-list_number bracketed text-style-label">
            <span class="step-list_count" />
          </span>
          <h3 class="step-list_title text-style-h4">{step.title}</h3>
          {step.text && <p class="step-list_text">{step.text}</p>}
        </li>
      ))}
    </ol>
  )
}

<style is:global>
  @layer components {
    .step-list_wrap {
      counter-reset: step;
      display: flex;
      flex-direction: column;
    }

    .step-list_item {
      counter-increment: step;
      display: grid;
      grid-template-columns: var(--space-8) 1fr;
      column-gap: var(--space-4);
      row-gap: var(--space-2);
      padding-block: var(--space-5);
      border-top: var(--border-width) solid var(--border);
      &:last-child {
        border-bottom: var(--border-width) solid var(--border);
      }
    }

    .step-list_number {
      grid-row: span 2;
      margin: 0;
      color: var(--text-2);
    }

    .step-list_count::before {
      content: counter(step, decimal-leading-zero);
    }

    .step-list_title {
      grid-column: 2;
      margin: 0;
    }

    .step-list_text {
      grid-column: 2;
      margin: 0;
      max-width: 44ch;
    }
  }
</style>

---
import Wordmark from "@/components/content/Wordmark.astro";
import { getItems } from "@/utils/content";
import {
  clinic,
  clinicLinks,
  concernHref,
  connectLinks,
  hoursLines,
  legalLinks,
} from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const concerns = await getItems("concerns");
const structure = concerns.filter(({ data }) => data.group === "Structure");
const surface = concerns.filter(({ data }) => data.group === "Surface");
const connect = connectLinks.filter((link) => link.href);
const year = new Date().getFullYear();
---

{
  render && (
    <footer class="site-footer_wrap theme-burgundy">
      <div class="site-footer_inner site-grid">
        <div class="site-footer_brand column-head">
          <Wordmark />
        </div>
        <div class="site-footer_groups">
          <nav class="site-footer_group" aria-label="Concerns of structure">
            <details open>
              <summary class="site-footer_title text-style-label">
                Structure
              </summary>
              <ul
                class="site-footer_list"
                data-op-list="footer-structure"
                data-op-source="astro:concerns"
              >
                {structure.map(({ id, data }) => (
                  <li data-op-item={id}>
                    <a class="site-footer_link" href={concernHref(id)}>
                      {data.name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
          <nav class="site-footer_group" aria-label="Concerns of surface">
            <details open>
              <summary class="site-footer_title text-style-label">
                Surface
              </summary>
              <ul
                class="site-footer_list"
                data-op-list="footer-surface"
                data-op-source="astro:concerns"
              >
                {surface.map(({ id, data }) => (
                  <li data-op-item={id}>
                    <a class="site-footer_link" href={concernHref(id)}>
                      {data.name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
          <nav class="site-footer_group" aria-label="The clinic">
            <details open>
              <summary class="site-footer_title text-style-label">
                Clinic
              </summary>
              <ul
                class="site-footer_list"
                data-op-list="footer-clinic"
                data-op-source="src/data/site.ts"
              >
                {clinicLinks.map((link) => (
                  <li data-op-item="">
                    <a class="site-footer_link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
          <div class="site-footer_group site-footer_visit">
            <h2 class="site-footer_title text-style-label">Visit us</h2>
            <address class="site-footer_facts">
              {clinic.street}, {clinic.locality} {clinic.region}{" "}
              {clinic.postcode}
            </address>
            <ul class="site-footer_facts">
              {hoursLines.map((line) => <li>{line}</li>)}
            </ul>
            <p class="site-footer_facts">
              <a
                class="site-footer_link"
                href={`tel:${clinic.phoneHref}`}
              >
                {clinic.phone}
              </a>
            </p>
          </div>
          <nav class="site-footer_group" aria-label="Connect">
            <details open>
              <summary class="site-footer_title text-style-label">
                Connect
              </summary>
              <ul
                class="site-footer_list"
                data-op-list="footer-connect"
                data-op-source="src/data/site.ts"
              >
                {connect.map((link) => (
                  <li data-op-item="">
                    <a class="site-footer_link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
          <nav class="site-footer_group" aria-label="Legal">
            <details open>
              <summary class="site-footer_title text-style-label">
                Legal
              </summary>
              <ul
                class="site-footer_list"
                data-op-list="footer-legal"
                data-op-source="src/data/site.ts"
              >
                {legalLinks.map((link) => (
                  <li data-op-item="">
                    <a class="site-footer_link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
        </div>
        <p class="site-footer_small text-style-small">
          &copy; {clinic.name}, <span class="site-footer_year">{year}</span>.
          AHPRA registration {clinic.ahpra}
        </p>
      </div>
    </footer>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";

  onPage((signal) => {
    const footer = document.querySelector<HTMLElement>(".site-footer_wrap");
    if (!footer) return;

    const year = footer.querySelector<HTMLElement>(".site-footer_year");
    if (year) year.textContent = String(new Date().getFullYear());

    /* job: the lists are folded into short groups on a phone, and open, as one block, from a tablet up */
    const groups = footer.querySelectorAll<HTMLDetailsElement>("details");
    const wide = window.matchMedia("(width >= 48rem)");
    const fold = () => {
      groups.forEach((group) => {
        group.open = wide.matches;
        const title = group.querySelector<HTMLElement>("summary");
        if (title) title.inert = wide.matches;
      });
    };
    fold();
    wide.addEventListener("change", fold, { signal });
  });
</script>

<style is:global>
  @layer components {
    .site-footer_wrap {
      padding: var(--space-8) var(--site-margin) var(--space-6);
    }

    .site-footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      margin-inline: auto;
      row-gap: var(--space-7);
      align-items: start;
    }

    .site-footer_brand {
      grid-column: 1 / -1;
      @media (width >= 64rem) {
        grid-column: 1 / span var(--head-span);
      }
    }

    .site-footer_groups {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-6);
      @media (width >= 64rem) {
        grid-column: var(--body-start) / -1;
      }
    }

    /* Phone: groups stacked, the lists folded. Tablet: two groups across. Computer: 3, 3 and 2 columns, as drawn. */
    .site-footer_group {
      grid-column: 1 / -1;
      @media (width >= 48rem) {
        grid-column: span 4;
      }
      @media (width >= 64rem) {
        grid-column: span 3;
        &:nth-child(3n) {
          grid-column: span 2;
        }
      }
    }

    .site-footer_title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      margin: 0 0 var(--space-3);
      list-style: none;
      color: var(--text-2);
      cursor: pointer;
      &::-webkit-details-marker {
        display: none;
      }
      /* The chevron of a folded group, on a phone only */
      &::after {
        content: "";
        width: 0.5em;
        height: 0.5em;
        border-right: var(--border-width) solid currentcolor;
        border-bottom: var(--border-width) solid currentcolor;
        rotate: 45deg;
        translate: 0 -0.15em;
        transition: rotate var(--duration-fast) var(--hover-ease);
        @media (width >= 48rem) {
          display: none;
        }
      }
      @media (width >= 48rem) {
        cursor: default;
      }
    }

    .site-footer_group details[open] .site-footer_title::after {
      rotate: 225deg;
      translate: 0 0.15em;
    }

    h2.site-footer_title {
      cursor: default;
      &::after {
        display: none;
      }
    }

    .site-footer_list {
      display: flex;
      flex-direction: column;
      padding-bottom: var(--space-2);
    }

    .site-footer_link {
      display: inline-block;
      padding-block: 0.125rem;
      font-family: var(--primary-family);
      font-variation-settings: var(--primary-variation);
      font-size: var(--text-main);
      line-height: 1.375;
      color: var(--link-text);
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--link-text-hover);
        }
      }
    }

    /* The facts are read, so they are set in the serif */
    .site-footer_facts {
      margin: 0 0 var(--space-3);
      font-style: normal;
      color: var(--text);
    }

    .site-footer_visit .site-footer_link {
      font-family: var(--serif-family);
      font-variation-settings: var(--serif-variation);
      color: var(--text);
    }

    .site-footer_small {
      grid-column: 1 / -1;
      margin: 0;
      color: var(--text-2);
      @media (width >= 64rem) {
        grid-column: var(--body-start) / -1;
      }
    }
  }
</style>

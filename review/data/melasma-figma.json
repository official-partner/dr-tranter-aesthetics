["1:357",590,181,697,176,1,"L","0-23:k0 #2c0f0a;23-65:k1 #2c0f0a;65-122:k0 #2c0f0a","Melasma is a distinct, hormonally influenced form of pigmentation that responds differently to standard pigment treatment."],
["1:360",590.47,475,216.27,15,1,"L","k2 #2c0f0a","Consultation"],
["1:361",796,475,216.27,15,1,"L","k2 #2c0f0a","Assessed by"],
["1:362",590,498,146,16,1,"L","k3 #2c0f0a","30 to 45 minutes"],
["1:363",796,498,230.34,16,1,"L","k3 #2c0f0a","Cosmetic Physician"],
["1:452",1513,494,191,18,0.5,"R","k7 #2c0f0a","BOOK A CONSULTATION →"],
["1:364",27.53,555.36,339.22,88,1,"L","k0 #2c0f0a","What is happening"],
["1:366",590,562.36,548,88,1,"L","k4 #2c0f0a","Melasma is a specific pattern of pigmentation influenced by hormonal factors and sun exposure, and it behaves differently from general sun damage, including a higher chance of recurrence and a lower tolerance for heat-based treatment. Because of this, treatment is usually more conservative and staged than for other pigmentation."],
["1:367",1298,562.36,42.63,15.22,1,"L","k5 #2c0f0a","[01]"],
["1:370",1441.63,562.36,150.59,15.22,1,"L","k5 #2c0f0a","Cumulative exposure"],
["1:373",1442,588,221,70,1,"L","k4 #2c0f0a","Melasma usually reflects cumulative exposure and skin behaviour over years, not a single recent cause."],
["1:368",1298,687,42.63,15.22,1,"L","k5 #2c0f0a","[02]"],
["1:371",1441.63,687,150.59,15.22,1,"L","k5 #2c0f0a","Barrier and turnover"],
["1:374",1442,713,216,70,1,"L","k4 #2c0f0a","Changes to the skin barrier and cell turnover rate influence how visible melasma becomes over time."],
["1:369",1298,812,42.63,15.22,1,"L","k5 #2c0f0a","[03]"],
["1:372",1441.63,812,150.59,15.22,1,"L","k5 #2c0f0a","Individual variation"],
["1:375",1442,838,199,70,1,"L","k4 #2c0f0a","How melasma presents and responds to treatment varies meaningfully between skin types."],
["1:365",27.53,1037,339.22,88,1,"L","k0 #2c0f0a","What we would consider"],
["1:392",27.53,1543.5,294.43,15,1,"L","k2 #2c0f0a","Recommended starting point"],
["1:376",591,1542,159,19,1,"L","k5 #2c0f0a","Medical-Grade Peels"],
["1:381",591,1569,413,53,1,"L","k4 #2c0f0a","Considered as a first-line, course-based approach to melasma, given its lower risk of aggravating pigment compared to heat-based devices."],
["1:395",1133,1542,147,18,0.5,"R","k7 #2c0f0a","VIEW treatment →"],
["1:393",27.53,2077,294.43,15,1,"L","k2 #2c0f0a","Also considered"],
["1:377",591,2079,158.98,16,1,"L","k6 #2c0f0a","Pico Laser"],
["1:382",591,2106.49,348.56,18,1,"L","k4 #2c0f0a","Pigment-targeting laser"],
["1:396",591,2139.49,147,18,0.5,"R","k7 #2c0f0a","VIEW treatment →"],
["1:379",1156,2079,226,16,1,"L","k6 #2c0f0a","Cosmelan / Dermamelan"],
["1:384",1156,2106.49,348.56,18,1,"L","k4 #2c0f0a","Depigmentation mask protocol"],
["1:398",1156,2139.49,147,18,0.5,"R","k7 #2c0f0a","VIEW treatment →"],
["1:394",27.53,2305.38,294.43,15,1,"L","k2 #2c0f0a","Often considered alongside"],
["1:378",591,2309.58,282,16,1,"L","k6 #2c0f0a","Pigmentation and sun damage"],
["1:383",591,2337.06,348.56,35,1,"L","k4 #2c0f0a","Often assessed alongside, since these concerns frequently share the same treatment options."],
["1:397",590,2388.07,134,18,0.5,"R","k7 #2c0f0a","View concern →"],
["1:380",1156,2309.58,241,16,1,"L","k6 #2c0f0a","Texture, pores and scarring"],
["1:385",1156,2337.06,348.56,35,1,"L","k4 #2c0f0a","Often assessed alongside, since these concerns frequently share the same treatment options."],
["1:399",1156,2388.07,134,18,0.5,"R","k7 #2c0f0a","View concern →"],
["1:412",24,2544,330,88,1,"L","k0 #2c0f0a","How we treat Melasma"],
["1:413",590.47,2559.41,42.63,15.22,1,"L","k5 #2c0f0a","[01]"],
["1:414",732,2559.27,265,16,1,"L","k5 #2c0f0a","Assessment first"],
["1:415",732,2587,294,70,1,"L","k4 #2c0f0a","We confirm melasma rather than assume it, since it is often confused with other pigmentation and responds poorly to the wrong treatment."],
["1:416",590.47,2685,42.63,15.22,1,"L","k5 #2c0f0a","[02]"],
["1:419",732,2685.61,265,15,1,"L","k5 #2c0f0a","Conservative, staged treatment"],
["1:422",732,2714,246.51,70,1,"L","k4 #2c0f0a","Lower-heat, course-based options are used first, with intensity increased only if needed and tolerated."],
["1:417",590.47,2812,42.63,15.22,1,"L","k5 #2c0f0a","[03]"],
["1:420",732,2812.37,265,15,1,"L","k5 #2c0f0a","Strict sun protection throughout"],
["1:423",732,2839.75,246.51,70,1,"L","k4 #2c0f0a","Daily broad-spectrum SPF is non-negotiable during treatment, since UV exposure can undo progress quickly."],
["1:418",590.47,2937,42.63,15.22,1,"L","k5 #2c0f0a","[04]"],
["1:421",732,2937,150.59,15.22,1,"L","k5 #2c0f0a","Ongoing monitoring"],
["1:424",732,2966,294,53,1,"L","k4 #2c0f0a","Melasma can recur, so we review and adjust the plan over time rather than treating it as a one-off."],
["1:436",41,3164,384,88,1,"L","k0 #2c0f0a","Products we would recommend"],
["1:442",43.5,3611.2,501,32,1,"L","k16 #2c0f0a","Vitamin C Antioxidant Serum"],
["1:444",607,3606,422.47,32,1,"L","k16 #2c0f0a","Retinal Renewal Serum"],
["1:443",1182,3610.41,422,32,1,"L","k16 #2c0f0a","Daily Mineral SPF 50+"],
["1:446",43,3661,344.44,53,1,"L","k17 #2c0f0a@0.50","Supports tone and brightness between in-clinic\npigmentation and redness treatments.\n"],
["1:447",606,3661,372.1,35,1,"L","k17 #2c0f0a@0.50","A nightly option to support cell turnover and texture\nalongside device-led resurfacing."],
["1:448",1183,3661,344.44,70,1,"L","k17 #2c0f0a@0.50","Broad-spectrum protection recommended following any device-led or injectable treatment, and as a daily habit regardless.\n"],

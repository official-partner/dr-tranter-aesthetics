  {
   "id": "59:1013",
   "x": 590.0,
   "y": 672.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "A doctor-led consultation assessing suitability for weight and body composition support, within a broader individualised plan."
  },
  {
   "id": "59:1014",
   "x": 590.0,
   "y": 2620.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "A structured depigmentation protocol developed for melasma, combining an in-clinic mask with a staged homecare programme."
  },
  {
   "id": "59:1015",
   "x": 590.0,
   "y": 1642.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Addresses structure and surface together in a single treatment, working on tightening, texture and definition simultaneously."
  },
  {
   "id": "59:1016",
   "x": 590.0,
   "y": 3573.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "A course-based option for pigmentation, texture and congestion, with the strength adjusted to suit your skin."
  },
  {
   "id": "59:1017",
   "x": 590.0,
   "y": 1147.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "An injectable that works gradually, stimulating the skin's own collagen production over a course of treatments."
  },
  {
   "id": "59:1018",
   "x": 590.0,
   "y": 3087.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Addresses pigmentation and visible redness across the face, chest and hands, using targeted intense pulsed light."
  },
  {
   "id": "59:1019",
   "x": 590.0,
   "y": 2144.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Considered for deeper texture, scarring and pigmentation concerns where a more intensive approach is clinically appropriate."
  },
  {
   "id": "59:1020",
   "x": 590.0,
   "y": 4051.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "A gentler option for congestion, dullness and early texture concerns, with little or no downtime afterwards."
  },
  {
   "id": "59:1021",
   "x": 589.0,
   "y": 4538.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "A lower-intensity radiofrequency facial for gentle warmth and ongoing skin quality support, with no real downtime."
  },
  {
   "id": "59:1022",
   "x": 589.0,
   "y": 5026.0,
   "w": 373.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "A multi-application laser, with settings ranging from a gentle refresh through to more intensive resurfacing."
  },
  {
   "id": "59:1023",
   "x": 1156.0,
   "y": 672.0,
   "w": 353.0,
   "h": 60.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Considered for restoring lost volume and softening lines from facial movement, following a full clinical assessment."
  },
  {
   "id": "59:1024",
   "x": 1156.0,
   "y": 2620.0,
   "w": 353.0,
   "h": 60.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "A non-invasive radiofrequency treatment for gentle, cumulative skin tightening, taken as a course with no downtime."
  },
  {
   "id": "59:1025",
   "x": 1156.0,
   "y": 1642.0,
   "w": 353.0,
   "h": 60.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Non-invasive support for facial muscle tone and underlying structure, with no downtime and no recovery period."
  },
  {
   "id": "59:1026",
   "x": 1156.0,
   "y": 3573.0,
   "w": 353.0,
   "h": 60.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "A considered, clinical alternative to spa-style facials, chosen for skin quality support between your other procedures."
  },
  {
   "id": "59:1027",
   "x": 1156.0,
   "y": 1147.0,
   "w": 353.0,
   "h": 60.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Our flagship treatment for skin laxity, tightening tissue beneath the surface for dramatic, visible non-surgical change."
  },
  {
   "id": "59:1028",
   "x": 1156.0,
   "y": 3087.0,
   "w": 353.0,
   "h": 60.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Considered for texture and scarring where a gentler, more gradual approach is the more appropriate choice."
  },
  {
   "id": "59:1029",
   "x": 1156.0,
   "y": 2144.0,
   "w": 353.0,
   "h": 60.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Often considered for pigmentation and sun damage, working in very short pulses with minimal downtime afterwards."
  },
  {
   "id": "59:1030",
   "x": 1156.0,
   "y": 4051.0,
   "w": 353.0,
   "h": 60.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Deep cleansing and hydration considered for congestion and dullness, often used alongside your other ongoing treatments."
  },
  {
   "id": "59:1031",
   "x": 1155.0,
   "y": 4538.0,
   "w": 353.0,
   "h": 60.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "A dedicated vascular laser for redness and visible vessels, treating a wider range of vessel sizes than light alone."
  },

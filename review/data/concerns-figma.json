 "_note": "Read by script from the Figma connector's layer listing (get_metadata, Nov 20). A text's size and line height are the system style its box holds (44 a title, 17.42 running text, 15.22 a name, 17.42 a link), the listing giving no type.",
 "texts": [
  {
   "id": "59:611",
   "x": 592.0,
   "y": 20.0,
   "w": 600.0,
   "h": 132.0,
   "size": 44,
   "lineHeight": 44,
   "align": "left",
   "text": "Concerns begin in one of two places: what supports the face, or what its surface shows."
  },
  {
   "id": "59:626",
   "x": 27.83203125,
   "y": 289.0,
   "w": 294.43359375,
   "h": 15.0,
   "size": 16,
   "lineHeight": 15.04,
   "align": "left",
   "text": "Structure"
  },
  {
   "id": "59:627",
   "x": 61.83203125,
   "y": 2428.0,
   "w": 294.43359375,
   "h": 15.0,
   "size": 16,
   "lineHeight": 15.04,
   "align": "left",
   "text": "Surface"
  },
  {
   "id": "59:635",
   "x": 590.0,
   "y": 590.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "VOLUME LOSS AND HOLLOWING"
  },
  {
   "id": "59:636",
   "x": 590.0,
   "y": 2729.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "Pigmentation and sun damage"
  },
  {
   "id": "59:637",
   "x": 590.0,
   "y": 1083.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "Skin laxity and sagging"
  },
  {
   "id": "59:638",
   "x": 590.0,
   "y": 3222.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "Texture, pores and scarring"
  },
  {
   "id": "59:639",
   "x": 590.0,
   "y": 1577.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "LIP ENHANCEMENT"
  },
  {
   "id": "59:640",
   "x": 590.0,
   "y": 2074.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "TEMPLE HOLLOWING"
  },
  {
   "id": "59:641",
   "x": 590.0,
   "y": 3716.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "Dullness and dehydration"
  },
  {
   "id": "59:642",
   "x": 590.0,
   "y": 4213.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "NECK, CHEST AND HANDS"
  },
  {
   "id": "59:643",
   "x": 1157.0,
   "y": 590.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "Jawline and chin definition"
  },
  {
   "id": "59:644",
   "x": 1157.0,
   "y": 2729.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "Redness and visible vessels"
  },
  {
   "id": "59:645",
   "x": 1157.0,
   "y": 1083.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "Lines from facial movement"
  },
  {
   "id": "59:646",
   "x": 1157.0,
   "y": 3222.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "Congestion and breakouts"
  },
  {
   "id": "59:647",
   "x": 1157.0,
   "y": 1577.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "UNDER-EYE HOLLOWING"
  },
  {
   "id": "59:648",
   "x": 1157.0,
   "y": 3716.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "Melasma"
  },
  {
   "id": "59:649",
   "x": 1157.0,
   "y": 4213.0,
   "w": 407.0,
   "h": 16.0,
   "size": 16,
   "lineHeight": 15.22,
   "align": "left",
   "text": "WEIGHT AND BODY COMPOSITION"
  },
  {
   "id": "59:650",
   "x": 590.0,
   "y": 618.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "The cheeks, temples and jawline often lose definition before the skin itself shows visible change. It is among the earliest signs of facial ageing."
  },
  {
   "id": "59:651",
   "x": 590.0,
   "y": 2757.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Years of sun exposure surface gradually, often appearing long after the exposure itself, and typically across the face, chest and the back of hands."
  },
  {
   "id": "59:652",
   "x": 590.0,
   "y": 1111.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Reduced elasticity means the skin no longer holds the same contours as closely as it once did, particularly through the cheeks, jawline and neck."
  },
  {
   "id": "59:653",
   "x": 590.0,
   "y": 3250.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Surface irregularity changes how light reads across the skin, which is why texture and scarring can often look far more pronounced under certain lighting."
  },
  {
   "id": "59:654",
   "x": 590.0,
   "y": 1605.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Lips lose volume and definition gradually, following the same structural changes as the rest of the face, with the border often softening first."
  },
  {
   "id": "59:655",
   "x": 590.0,
   "y": 2102.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Temple volume loss slowly changes the underlying support structure for the whole upper face, often well before the change itself is ever consciously noticed."
  },
  {
   "id": "59:656",
   "x": 590.0,
   "y": 3744.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Skin that looks tired often needs hydration and renewal rather than active treatment, and tends to respond well to a consistent, well-matched daily routine."
  },
  {
   "id": "59:657",
   "x": 590.0,
   "y": 4241.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Skin on the neck, chest and hands often ages faster than the face, and is assessed and treated with the same rigour as any facial concern."
  },
  {
   "id": "59:658",
   "x": 1157.0,
   "y": 618.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Definition through the jawline often softens gradually over time, and is one of the more visible changes people first notice in their own photographs."
  },
  {
   "id": "59:659",
   "x": 1157.0,
   "y": 2757.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Visible vessels and persistent redness often reflect a sensitivity built up over many years, and they tend to become steadily more noticeable with age."
  },
  {
   "id": "59:660",
   "x": 1157.0,
   "y": 1111.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Repeated muscle movement gradually etches lines into the skin that remain visible even at rest, long after the expression that made them has passed."
  },
  {
   "id": "59:661",
   "x": 1157.0,
   "y": 3250.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Ongoing congestion is often a sign of an imbalanced routine or a compromised skin barrier, rather than a problem with the underlying skin itself."
  },
  {
   "id": "59:662",
   "x": 1157.0,
   "y": 1605.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "The under-eye area often hollows earlier than the rest of the face, and the shadowing from that hollowing can compound the visible effect considerably."
  },
  {
   "id": "59:663",
   "x": 1157.0,
   "y": 3744.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "Melasma is a distinct, hormonally influenced form of pigmentation that responds differently to standard pigment treatment."
  },
  {
   "id": "59:664",
   "x": 1157.0,
   "y": 4241.0,
   "w": 407.0,
   "h": 53.0,
   "size": 16,
   "lineHeight": 17.42,
   "align": "left",
   "text": "For patients wanting to discuss weight and body composition as part of a broader plan, assessed individually through a doctor-led consultation."
  },
  {
   "id": "59:665",
   "x": 590.0,
   "y": 685.0,
   "w": 134.0,
   "h": 18.0,
   "size": 15,

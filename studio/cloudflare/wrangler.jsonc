{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dr-tranter-studio",
  "main": "../src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Keep diagnostic logging opt-in to avoid unexpected Observability charges.
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 50 },
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  "containers": [
    {
      "class_name": "PreviewContainer",
      "image": "../Dockerfile",
      "max_instances": 1,
      // Builds need room for source, Git objects, dependencies and isolated output.
      "instance_type": "standard-2",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "PREVIEW", "class_name": "PreviewContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PreviewContainer"] }],
  "r2_buckets": [{ "binding": "DRAFTS", "bucket_name": "dr-tranter-studio-drafts" }],
  "vars": {
    "STUDIO_ORIGIN": "https://tranter.officialpartner.work",
    "PREVIEW_ORIGIN": "https://tranter-preview.officialpartner.work",
    "GITHUB_REPOSITORY": "official-partner/dr-tranter-aesthetics",
    "GITHUB_BRANCH": "review",
    "GITHUB_APP_ID": "5945806",
    "GITHUB_INSTALLATION_ID": "186333314",
    "GITHUB_CLIENT_ID": "Iv23liyAVA9DCCqeFajc",
    "EDITOR_ACCESS": "repository",
    "EDITOR_GITHUB_IDS": "",
    // How people sign in to Studio. Client secrets are never stored here; add them with `wrangler secret put`.
    "AUTH_PROVIDER": "google",
    "GOOGLE_CLIENT_ID": "1031552148880-0288opmbvu9o1bhrvb4adv8huo12cn3c.apps.googleusercontent.com",
    "AUTH_ALLOWED_EMAILS": "samuel@officialpartner.work",
    "AUTH_BOOTSTRAP_ADMIN": "google:samuel@officialpartner.work",
  },
}
